exports[`flag off — byte-identical to the pre-migration markup (portalled) > BoardSheet 1`] = `"<div class="fixed inset-0 z-[100] bg-v2-ink/40" aria-hidden="true" style="opacity: 0;"></div><section role="dialog" aria-modal="true" aria-label="איך צוברים נקודות" dir="rtl" class="fixed inset-x-0 bottom-0 z-[101] mx-auto max-w-md rounded-t-[28px] bg-white shadow-v2-sheet" style="max-height: 85vh; transform: translateY(100%);"><div class="pt-2.5 pb-1"><span class="block mx-auto w-10 h-[5px] rounded-full bg-[#d5dde2]"></span></div><div class="flex items-center justify-between px-5 pt-1 pb-2"><span class="text-[17px] font-black text-v2-ink tracking-v2-tight">איך צוברים נקודות</span><button type="button" aria-label="סגור" class="w-9 h-9 rounded-full bg-v2-surface ring-1 ring-inset ring-v2-hairline flex items-center justify-center text-v2-ink-2 active:scale-[0.97] transition-transform ease-v2"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="overflow-y-auto px-5 pb-[calc(20px+env(safe-area-inset-bottom))]" style="max-height: calc(85vh - 72px);"><p>גוף</p></div></section>"`;

exports[`flag off — byte-identical to the pre-migration markup (portalled) > ParentProgramSheet 1`] = `"<div class="fixed inset-0 bg-black/40 z-[60]" style="opacity: 0;"></div><div role="dialog" aria-modal="true" aria-label="label:upper_body" class="fixed bottom-0 inset-x-0 z-[61] overflow-y-auto bg-white rounded-t-2xl" dir="rtl" style="max-height: 85vh; transform: translateY(100%);"><div class="mx-auto max-w-md"><div class="flex justify-center pt-3 pb-1"><div class="w-10 h-1 rounded-full bg-gray-200"></div></div><div class="flex items-start justify-between gap-3 px-5 pt-3 pb-3"><div class="flex min-w-0 items-center gap-3"><span class="text-gray-900"><i data-icon="upper_body"></i></span><div class="min-w-0"><h2 class="truncate text-lg font-black text-gray-900">label:upper_body</h2><p class="text-xs font-bold text-gray-500 tabular-nums">רמה 4 (ממוצע)</p></div></div><button type="button" aria-label="סגירה" class="w-8 h-8 shrink-0 flex items-center justify-center rounded-full bg-gray-100 active:bg-gray-200"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x w-4 h-4 text-gray-500" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="px-5 pb-2 space-y-5"><p class="text-sm text-gray-600 leading-relaxed">לתוכנית אב אין מפת התקדמות משלה. ההתקדמות נמדדת בכל תוכנית בת, והרמה כאן היא הממוצע שלהן.</p><div class="space-y-2"><p class="text-xs font-bold text-gray-400 tracking-wide">תוכניות בנות</p><button type="button" class="flex w-full items-center gap-3 rounded-xl bg-gray-50 p-3 text-right active:bg-gray-100 transition-colors"><span class="text-gray-900"><i data-icon="push"></i></span><div class="min-w-0 flex-1"><p class="truncate text-sm font-bold text-gray-900">label:push</p><p class="mt-0.5 truncate text-xs font-medium text-gray-500 tabular-nums">רמה 4/10</p></div><span class="whitespace-nowrap text-sm font-black text-gray-900 tabular-nums">37%</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left h-4 w-4 shrink-0 text-gray-400" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button></div><div class="space-y-2"><p class="text-xs font-bold text-gray-400 tracking-wide">עוד לא בדקת רמה</p><div class="flex w-full items-center gap-3 rounded-xl bg-gray-50 p-3 text-right active:bg-gray-100 transition-colors"><span class="text-gray-400"><i data-icon="pull"></i></span><div class="min-w-0 flex-1"><p class="truncate text-sm font-bold text-gray-900">label:pull</p><p class="mt-0.5 truncate text-xs font-medium text-gray-500 tabular-nums">האימונים לא יכללו את התוכנית עד שתבדקו רמה</p></div><button type="button" class="shrink-0 rounded-full bg-brand-cta px-4 py-1.5 text-xs font-bold text-on-brand active:opacity-80">בדקו רמה</button></div></div><button type="button" class="w-full py-3 rounded-xl bg-gray-100 text-gray-700 text-sm font-bold active:bg-gray-200 transition-colors">סגירה</button></div></div></div>"`;
