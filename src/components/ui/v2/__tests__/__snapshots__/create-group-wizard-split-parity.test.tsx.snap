-all bg-v2-cta text-v2-on-cta shadow-v2-cta">2</div><div class="flex-1 h-0.5 rounded bg-v2-hairline"></div><div class="flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-black transition-all bg-v2-surface text-v2-muted ring-1 ring-inset ring-v2-hairline">3</div><div class="flex-1 h-0.5 rounded bg-v2-hairline"></div><div class="flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-black transition-all bg-v2-surface text-v2-muted ring-1 ring-inset ring-v2-hairline">4</div><div class="flex-1 h-0.5 rounded bg-v2-hairline"></div><div class="flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-black transition-all bg-v2-surface text-v2-muted ring-1 ring-inset ring-v2-hairline">5</div><div class="flex-1 h-0.5 rounded bg-v2-hairline"></div><div class="flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-black transition-all bg-v2-surface text-v2-muted ring-1 ring-inset ring-v2-hairline">6</div></div><p class="mt-1.5 whitespace-nowrap text-center text-[12px] font-bold text-v2-muted">פנייה לארגון</p></div><div class="flex-1 overflow-y-auto px-5 pb-4" dir="rtl"><div data-motion="{&quot;initial&quot;:{&quot;opacity&quot;:0,&quot;x&quot;:-16},&quot;animate&quot;:{&quot;opacity&quot;:1,&quot;x&quot;:0},&quot;exit&quot;:{&quot;opacity&quot;:0,&quot;x&quot;:16},&quot;transition&quot;:{&quot;duration&quot;:0.18}}"><div class="space-y-4 pt-4 text-right" dir="rtl"><div class="rounded-v2-card bg-v2-tint px-5 py-6 text-center"><span class="mx-auto mb-3 grid h-14 w-14 place-items-center rounded-full bg-white text-v2-deep shadow-v2-ring" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase" aria-hidden="true"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path><rect width="20" height="14" x="2" y="6" rx="2"></rect></svg></span><h3 class="text-[17px] font-black text-v2-ink">רוצים ליגה רשמית למקום העבודה?</h3><p class="mx-auto mt-1.5 max-w-[290px] text-[14px] font-semibold leading-relaxed text-v2-ink-2">פנו לHR / מנהל ישיר ובקשו שישתפו פעולה עם Out — ואנחנו נפתח את הליגה הרשמית!</p></div><div class="rounded-[20px] bg-white p-4 shadow-v2-ring"><p class="mb-3 text-[15px] font-black text-v2-ink">איך זה עובד?</p><ol class="space-y-2.5"><li class="flex items-center gap-2.5"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-v2-tint text-[12px] font-black text-v2-deep">1</span><span class="text-[14px] font-semibold text-v2-ink-2">שלחו את ההודעה לHR / מנהל ישיר</span></li><li class="flex items-center gap-2.5"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-v2-tint text-[12px] font-black text-v2-deep">2</span><span class="text-[14px] font-semibold text-v2-ink-2">הם יצרו קשר עם Out</span></li><li class="flex items-center gap-2.5"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-v2-tint text-[12px] font-black text-v2-deep">3</span><span class="text-[14px] font-semibold text-v2-ink-2">הליגה הרשמית של החברה נפתחת!</span></li></ol></div><button type="button" class="flex h-12 w-full items-center justify-center gap-2 whitespace-nowrap rounded-full text-[15px] font-extrabold transition-[transform,box-shadow,background-color] duration-150 ease-v2 active:scale-[0.97] bg-white text-v2-deep shadow-v2-ring"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send h-4 w-4" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg>שלח הודעה לHR / מנהל ישיר</button><button type="button" class="h-11 w-full whitespace-nowrap rounded-full text-[14px] font-extrabold text-v2-muted transition-transform duration-150 ease-v2 active:scale-[0.97]">המשך בלי לשלוח</button></div><div class="space-y-5 pt-4"><div><label class="mb-2 block whitespace-nowrap text-[13px] font-extrabold text-v2-deep">שם הקבוצה *</label><input type="text" placeholder="לדוגמה: קבוצת ריצה שכונתית" maxlength="60" class="h-12 w-full rounded-[16px] bg-white px-4 text-[15px] font-semibold text-v2-ink shadow-v2-ring outline-none placeholder:text-v2-muted focus:ring-2 focus:ring-v2-accent" value=""><p class="mt-1 text-left text-[11px] font-bold tabular-nums text-v2-muted">0/60</p></div><div><label class="mb-2 block whitespace-nowrap text-[13px] font-extrabold text-v2-deep">קטגוריה</label><div class="grid grid-cols-3 gap-2"><button type="button" aria-pressed="true" class="h-11 truncate whitespace-nowrap rounded-full px-3 text-[14px] font-extrabold transition-[transform,box-shadow,background-color] duration-150 ease-v2 active:scale-[0.97] bg-v2-tint text-v2-deep ring-1 ring-inset ring-v2-accent/40">ריצה</button><button type="button" aria-pressed="false" class="h-11 truncate whitespace-nowrap rounded-full px-3 text-[14px] font-extrabold transition-[transform,box-shadow,background-color] duration-150 ease-v2 active:scale-[0.97] bg-white text-v2-ink-2 shadow-v2-ring">הליכה</button><button type="button" aria-pressed="false" class="h-11 truncate whitespace-nowrap rounded-full px-3 text-[14px] font-extrabold transition-[transform,box-shadow,background-color] duration-150 ease-v2 active:scale-[0.97] bg-white text-v2-ink-2 shadow-v2-ring">קליסתניקס</button><button type="button" aria-pressed="false" class="h-11 truncate whitespace-nowrap rounded-full px-3 text-[14px] font-extrabold transition-[transform,box-shadow,background-color] duration-150 ease-v2 active:scale-[0.97] bg-white text-v2-ink-2 shadow-v2-ring">יוגה</button><button type="button" aria-pressed="false" class="h-11 truncate whitespace-nowrap rounded-full px-3 text-[14px] font-extrabold transition-[transform,box-s