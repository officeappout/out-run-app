  "<div><div class="fixed inset-0 z-[92] bg-black/50" style="backdrop-filter: blur(4px);" data-motion="{&quot;initial&quot;:{&quot;opacity&quot;:0},&quot;animate&quot;:{&quot;opacity&quot;:1},&quot;exit&quot;:{&quot;opacity&quot;:0}}"></div><div class="kb-sheet fixed bottom-0 left-0 right-0 z-[93] max-w-md mx-auto bg-white flex flex-col rounded-t-[28px] shadow-v2-sheet" style="height: 92dvh;" data-motion="{&quot;initial&quot;:{&quot;y&quot;:&quot;100%&quot;},&quot;animate&quot;:{&quot;y&quot;:0},&quot;exit&quot;:{&quot;y&quot;:&quot;100%&quot;},&quot;transition&quot;:{&quot;type&quot;:&quot;spring&quot;,&quot;stiffness&quot;:300,&quot;damping&quot;:32,&quot;mass&quot;:0.9}}"><div class="flex-shrink-0 px-5 pt-4 pb-3" dir="rtl"><div class="mx-auto mb-4 rounded-full h-1.5 w-10 bg-v2-pill-border"></div><div class="flex items-center justify-between mb-4"><h2 class="text-[22px] font-black !tracking-[-0.02em] text-v2-ink">צורי קהילה חדשה</h2><button aria-label="סגירה" class="grid h-9 w-9 place-items-center rounded-full bg-v2-surface ring-1 ring-inset ring-v2-hairline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x h-4 w-4 text-v2-ink" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="flex items-center gap-1.5"><div class="flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-black transition-all bg-v2-cta text-v2-on-cta shadow-v2-cta">1</div><div class="flex-1 h-0.5 rounded bg-v2-hairline"></div><div class="flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-black transition-all bg-v2-surface text-v2-muted ring-1 ring-inset ring-v2-hairline">2</div><div class="flex-1 h-0.5 rounded bg-v2-hairline"></div><div class="flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-black transition-all bg-v2-surface text-v2-muted ring-1 ring-inset ring-v2-hairline">3</div><div class="flex-1 h-0.5 rounded bg-v2-hairline"></div><div class="flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-black transition-all bg-v2-surface text-v2-muted ring-1 ring-inset ring-v2-hairline">4</div><div class="flex-1 h-0.5 rounded bg-v2-hairline"></div><div class="flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-black transition-all bg-v2-surface text-v2-muted ring-1 ring-inset ring-v2-hairline">5</div><div class="flex-1 h-0.5 rounded bg-v2-hairline"></div><div class="flex items-center justify-center w-6 h-6 rounded-full text-[10px] font-black transition-all bg-v2-surface text-v2-muted ring-1 ring-inset ring-v2-hairline">6</div></div><p class="mt-1.5 whitespace-nowrap text-center text-[12px] font-bold text-v2-muted">פנייה לארגון</p></div><div class="flex-1 overflow-y-auto px-5 pb-4" dir="rtl"><div data-motion="{&quot;initial&quot;:{&quot;opacity&quot;:0,&quot;x&quot;:-16},&quot;animate&quot;:{&quot;opacity&quot;:1,&quot;x&quot;:0},&quot;exit&quot;:{&quot;opacity&quot;:0,&quot;x&quot;:16},&quot;transition&quot;:{&quot;duration&quot;:0.18}}"><div class="space-y-4 pt-4 text-right" dir="rtl"><div class="rounded-v2-card bg-v2-tint px-5 py-6 text-center"><span class="mx-auto mb-3 grid h-14 w-14 place-items-center rounded-full bg-white text-v2-deep shadow-v2-ring" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg></span><h3 class="text-[17px] font-black text-v2-ink">רוצים ליגה רשמית להקמפוס?</h3><p class="mx-auto mt-1.5 max-w-[290px] text-[14px] font-semibold leading-relaxed text-v2-ink-2">פנו לאגודת הסטודנטים ובקשו שישתפו פעולה עם Out — ואנחנו נפתח את הליגה הרשמית!</p></div><div class="rounded-[20px] bg-white p-4 shadow-v2-ring"><p class="mb-3 text-[15px] font-black text-v2-ink">איך זה עובד?</p><ol class="space-y-2.5"><li class="flex items-center gap-2.5"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-v2-tint text-[12px] font-black text-v2-deep">1</span><span class="text-[14px] font-semibold text-v2-ink-2">שלחו את ההודעה לאגודת הסטודנטים</span></li><li class="flex items-center gap-2.5"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-v2-tint text-[12px] font-black text-v2-deep">2</span><span class="text-[14px] font-semibold text-v2-ink-2">הם יצרו קשר עם Out</span></li><li class="flex items-center gap-2.5"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-v2-tint text-[12px] font-black text-v2-deep">3</span><span class="text-[14px] font-semibold text-v2-ink-2">הליגה הרשמית של הקמפוס נפתחת!</span></li></ol></div><button type="button" class="flex h-12 w-full items-center justify-center gap-2 whitespace-nowrap rounded-full text-[15px] font-extrabold transition-[transform,box-shadow,background-color] duration-150 ease-v2 active:scale-[0.97] bg-white text-v2-deep shadow-v2-ring"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send h-4 w-4" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg>שלח הודעה לאגודת הסטודנטים</button><button type="button" class="h-11 w-full whitespace-nowrap rounded-full text-[14px] font-extrabold text-v2-muted transition-transform duration-150 ease-v2 active:scale-[0.97]">המשך בלי לשלוח</button></div></div></div><div class="flex-shrink-0 px-5 pt-4 pb-4 border-t border-v2-hairline" style="padding-bottom: calc(1rem + env(0px * , * safe-area-inset-bottom));"><div class="flex items-center gap-3" dir="rtl"><button aria-label="חזרה" class="grid h-12 w-12 flex-shrink-0 place-items-center rounded-full bg-white shadow-v2-ring transition-transform active:scale-90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-5 w-5 text-v2-ink" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button><button class="flex h-12 flex-1 items-center justify-center gap-2 rounded-full bg-v2-cta text-[16px] font-extrabold text-v2-on-cta shadow-v2-cta transition-transform active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-40">המשך ליצירה<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left w-4 h-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button></div></div></div></div>
