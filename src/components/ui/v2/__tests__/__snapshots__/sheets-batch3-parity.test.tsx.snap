exports[`flag off — byte-identical to the pre-migration markup > PartnerFilterSheet 1`] = `"<div class="fixed inset-0 bg-black/40 z-[48] pointer-events-auto" style="opacity:0"></div><div class="fixed bottom-0 left-0 right-0 z-[49] bg-white rounded-t-3xl shadow-2xl pointer-events-auto" dir="rtl" style="padding-bottom:calc(env(safe-area-inset-bottom, 0px) + 56px);transform:translateY(100%)"><div class="flex justify-center pt-3 pb-2 cursor-grab active:cursor-grabbing" style="touch-action:none"><div class="rounded-full bg-gray-300" style="width:36px;height:4px"></div></div><div class="flex items-center justify-between px-5 pb-3"><button type="button" class="text-[13px] font-bold text-gray-500 active:text-gray-700 pointer-events-auto">אפס</button><h2 class="text-base font-black text-gray-900">פילטרים</h2><button type="button" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center active:scale-90 transition-transform pointer-events-auto" aria-label="סגור"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x text-gray-600" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="px-5 pb-4 space-y-5 max-h-[60vh] overflow-y-auto"><section><div class="flex items-center justify-between mb-2"><span class="text-[13px] font-black text-gray-800">מרחק</span><span class="text-[13px] font-black" style="color:#00ADEF">עד 5 ק״מ</span></div><div class="relative w-full" style="height:16px"><div class="absolute top-1/2 left-0 right-0 h-1.5 -translate-y-1/2 bg-gray-200 rounded-full"></div><div class="absolute top-1/2 h-1.5 -translate-y-1/2 rounded-full" style="right:0;left:68.9655172413793%;background-color:#00ADEF"></div><input type="range" min="0.5" max="15" step="0.5" dir="rtl" class="absolute inset-0 w-full h-full appearance-none bg-transparent cursor-pointer" style="accent-color:#00ADEF" aria-label="מרחק חיפוש בקילומטרים" value="5"/></div></section><section><div class="flex items-center justify-between mb-2"><span class="text-[13px] font-black text-gray-800">מגדר</span></div><div class="flex gap-2"><button type="button" class="flex-1 rounded-full text-[13px] font-bold transition-colors active:scale-95" style="height:36px;background-color:#00ADEF;color:#FFFFFF;border:none">הכל</button><button type="button" class="flex-1 rounded-full text-[13px] font-bold transition-colors active:scale-95" style="height:36px;background-color:#FFFFFF;color:#4B5563;border:0.5px solid rgba(0,0,0,0.12)">גברים</button><button type="button" class="flex-1 rounded-full text-[13px] font-bold transition-colors active:scale-95" style="height:36px;background-color:#FFFFFF;color:#4B5563;border:0.5px solid rgba(0,0,0,0.12)">נשים</button></div></section><section><div class="mb-2"><span class="text-[13px] font-black text-gray-800">טווח גילאים</span></div><div class="relative w-full" style="height:36px"><div class="absolute text-[11px] font-black pointer-events-none whitespace-nowrap" dir="ltr" style="top:0;right:0%;transform:translateX(50%);color:#00ADEF">18</div><div class="absolute text-[11px] font-black pointer-events-none whitespace-nowrap" dir="ltr" style="top:0;right:100%;transform:translateX(50%);color:#00ADEF">99</div><div class="absolute left-0 right-0" style="top:20px;height:16px"><div class="absolute top-1/2 left-0 right-0 h-1.5 -translate-y-1/2 bg-gray-200 rounded-full"></div><div class="absolute top-1/2 h-1.5 -translate-y-1/2 rounded-full" style="right:0%;left:0%;background-color:#00ADEF"></div><input type="range" min="18" max="99" step="1" dir="rtl" class="absolute inset-0 w-full h-full appearance-none bg-transparent pointer-events-none [&amp;::-webkit-slider-thumb]:pointer-events-auto [&amp;::-moz-range-thumb]:pointer-events-auto" style="accent-color:#00ADEF" aria-label="גיל מינימום" value="18"/><input type="range" min="18" max="99" step="1" dir="rtl" class="absolute inset-0 w-full h-full appearance-none bg-transparent pointer-events-none [&amp;::-webkit-slider-thumb]:pointer-events-auto [&amp;::-moz-range-thumb]:pointer-events-auto" style="accent-color:#00ADEF" aria-label="גיל מקסימום" value="99"/></div></div><div class="flex justify-between" style="font-size:10px;color:#9CA3AF"><span>צעיר</span><span>מבוגר</span></div></section></div><div class="px-5 pt-2 pb-4"><button type="button" class="w-full py-3 text-white text-sm font-black active:scale-[0.98] transition-transform shadow-sm pointer-events-auto" style="background-color:#00ADEF;border-radius:12px">החל</button></div></div>"`;

exports[`flag off — byte-identical to the pre-migration markup > ReportContentSheet 1`] = `"<div class="fixed inset-0 z-[92] bg-black/50" style="backdrop-filter:blur(4px);opacity:0"></div><div class="fixed bottom-0 left-0 right-0 z-[93] max-w-md mx-auto bg-white dark:bg-slate-900 rounded-t-3xl shadow-2xl" style="transform:translateY(100%)"><div class="w-10 h-1 bg-gray-300 dark:bg-gray-600 rounded-full mx-auto mt-3"></div><button class="absolute top-4 left-4 w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x text-gray-500" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button><div class="px-6 pt-6 pb-10" dir="rtl"><div class="flex items-center gap-2 mb-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flag w-5 h-5 text-red-500" aria-hidden="true"><path d="M4 22V4a1 1 0 0 1 .4-.8A6 6 0 0 1 8 2c3 0 5 2 7.333 2q2 0 3.067-.8A1 1 0 0 1 20 4v10a1 1 0 0 1-.4.8A6 6 0 0 1 16 16c-3 0-5-2-8-2a6 6 0 0 0-4 1.528"></path></svg><h3 class="text-lg font-black text-gray-900 dark:text-white">דיווח על הקבוצה</h3></div><p class="text-sm text-gray-500 dark:text-gray-400 mb-5">מדוע ברצונך לדווח על הקבוצה “רצים בפארק”?</p><div class="space-y-2 mb-6"><button class="w-full text-right px-4 py-3 rounded-2xl text-sm font-bold transition-all border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">ספאם / תוכן מסחרי</button><button class="w-full text-right px-4 py-3 rounded-2xl text-sm font-bold transition-all border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">תוכן לא ראוי</button><button class="w-full text-right px-4 py-3 rounded-2xl text-sm font-bold transition-all border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">הטרדה או אלימות</button><button class="w-full text-right px-4 py-3 rounded-2xl text-sm font-bold transition-all border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">מידע מטעה</button><button class="w-full text-right px-4 py-3 rounded-2xl text-sm font-bold transition-all border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">אחר</button></div><button disabled="" class="w-full py-3.5 rounded-2xl text-sm font-black bg-red-500 text-white disabled:opacity-40 flex items-center justify-center gap-2 transition-all active:scale-[0.97]">שלח דיווח</button></div></div>"`;
