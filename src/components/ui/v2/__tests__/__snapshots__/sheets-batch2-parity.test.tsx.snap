exports[`flag off — byte-identical to the pre-migration markup > FavoritesSheet 1`] = `"<div class="fixed inset-0 bg-black/40 z-[98]" style="opacity:0"></div><div class="fixed bottom-0 inset-x-0 z-[99] bg-white rounded-t-3xl shadow-2xl max-h-[92dvh] flex flex-col" dir="rtl" style="transform:translateY(100%)"><div class="flex justify-center pt-3 pb-1 shrink-0"><div class="w-10 h-1 bg-gray-300 rounded-full"></div></div><div class="flex items-center justify-between px-5 py-3 shrink-0 border-b border-gray-100"><h2 class="text-lg font-bold text-gray-900">שמורים</h2><button type="button" class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-500 active:scale-95 transition-transform" aria-label="סגור"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x w-4 h-4" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="flex-1 overflow-y-auto px-4 py-4"><div data-favorites-tab="classic"></div><div class="h-6"></div></div></div>"`;

exports[`flag off — byte-identical to the pre-migration markup > QuickReportSheet 1`] = `"<div class="kb-fit fixed inset-0 z-[100] flex flex-col justify-end"><div class="absolute inset-0 bg-black/30 backdrop-blur-sm" style="opacity:0"></div><div class="kb-cap relative bg-white rounded-t-3xl shadow-2xl p-5" dir="rtl" style="transform:translateY(100%)"><div class="flex items-center justify-between mb-4"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap text-[#00E5FF]" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg><h3 class="text-slate-900 text-base font-bold">דיווח מהיר</h3></div><button class="p-2 rounded-full bg-slate-100 text-slate-500 active:scale-90 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><p class="text-slate-400 text-xs font-bold mb-2">מה הבעיה?</p><div class="grid grid-cols-4 gap-2 mb-4"><button class="flex flex-col items-center gap-1 py-2.5 rounded-xl text-[10px] font-bold transition-all border bg-slate-50 text-slate-500 border-slate-200"><span class="text-lg">🔧</span><span>ציוד פגום</span></button><button class="flex flex-col items-center gap-1 py-2.5 rounded-xl text-[10px] font-bold transition-all border bg-slate-50 text-slate-500 border-slate-200"><span class="text-lg">💡</span><span>תאורה לא עובדת</span></button><button class="flex flex-col items-center gap-1 py-2.5 rounded-xl text-[10px] font-bold transition-all border bg-slate-50 text-slate-500 border-slate-200"><span class="text-lg">🚰</span><span>חוסר מים</span></button><button class="flex flex-col items-center gap-1 py-2.5 rounded-xl text-[10px] font-bold transition-all border bg-slate-50 text-slate-500 border-slate-200"><span class="text-lg">🚫</span><span>ונדליזם</span></button><button class="flex flex-col items-center gap-1 py-2.5 rounded-xl text-[10px] font-bold transition-all border bg-slate-50 text-slate-500 border-slate-200"><span class="text-lg">🧹</span><span>ניקיון</span></button><button class="flex flex-col items-center gap-1 py-2.5 rounded-xl text-[10px] font-bold transition-all border bg-slate-50 text-slate-500 border-slate-200"><span class="text-lg">⚠️</span><span>בעיית בטיחות</span></button><button class="flex flex-col items-center gap-1 py-2.5 rounded-xl text-[10px] font-bold transition-all border bg-slate-50 text-slate-500 border-slate-200"><span class="text-lg">📝</span><span>אחר</span></button></div><textarea placeholder="פרטים נוספים (לא חובה)..." rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-slate-900 text-sm placeholder:text-slate-400 outline-none focus:border-[#00E5FF] transition-colors resize-none mb-4"></textarea><button disabled="" class="w-full py-3.5 rounded-2xl text-sm font-bold transition-all flex items-center justify-center gap-2 bg-slate-100 text-slate-300 cursor-not-allowed">שלח דיווח ⚡</button></div></div>"`;

exports[`flag off — byte-identical to the pre-migration markup > UnifiedPlusDrawer 1`] = `"<div class="fixed inset-0 z-[100] flex items-end justify-center bg-black/40" style="backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);opacity:0"><div class="w-full max-w-md bg-white rounded-t-3xl shadow-2xl overflow-hidden" dir="rtl" style="padding-bottom:max(1.5rem, env(safe-area-inset-bottom));transform:translateY(100%)"><div class="flex justify-center pt-3 pb-1"><div class="w-10 h-1 rounded-full bg-gray-200"></div></div><div class="flex items-center justify-between px-5 pb-2"><h3 class="text-base font-black text-gray-900">מה תרצה לעשות?</h3><button aria-label="סגירה" class="p-1.5 rounded-lg bg-gray-100 text-gray-400 hover:bg-gray-200 active:scale-90 transition-all"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x w-4 h-4" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="px-5 pb-4 space-y-4"><div class="space-y-2"><div class="text-[11px] font-bold text-gray-400 px-1">פעילות</div><div class="space-y-1.5"><button class="w-full flex items-center gap-3 px-3 py-3 rounded-2xl bg-gray-50 hover:bg-gray-100 active:scale-[0.99] transition-all text-right"><div class="flex-shrink-0 w-10 h-10 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-footprints text-gray-700" aria-hidden="true"><path d="M4 16v-2.38C4 11.5 2.97 10.5 3 8c.03-2.72 1.49-6 4.5-6C9.37 2 10 3.8 10 5.5c0 3.11-2 5.66-2 8.68V16a2 2 0 1 1-4 0Z"></path><path d="M20 20v-2.38c0-2.12 1.03-3.12 1-5.62-.03-2.72-1.49-6-4.5-6C14.63 6 14 7.8 14 9.5c0 3.11 2 5.66 2 8.68V20a2 2 0 1 0 4 0Z"></path><path d="M16 17h4"></path><path d=