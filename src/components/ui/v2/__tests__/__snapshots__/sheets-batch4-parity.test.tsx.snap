exports[`flag off — byte-identical to the pre-migration markup > EditProfileModal 1`] = `"<div class="kb-fit fixed inset-0 z-[100] bg-black/40 flex items-end sm:items-center justify-center" style="backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);opacity:0"><div class="kb-cap bg-white rounded-t-3xl sm:rounded-3xl shadow-2xl w-full max-w-md max-h-[92vh] flex flex-col" dir="rtl" style="transform:translateY(100%)"><div class="sticky top-0 bg-white/95 backdrop-blur-sm border-b border-gray-100 px-5 py-3.5 flex items-center justify-between z-10 flex-shrink-0 rounded-t-3xl"><button type="button" class="text-sm font-bold text-[#00ADEF] disabled:opacity-50 flex items-center gap-1.5">שמירה</button><h2 class="text-base font-black text-gray-900">עריכת פרופיל</h2><button type="button" class="p-1 text-gray-400 hover:text-gray-600 disabled:opacity-40"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="flex-1 overflow-y-auto px-5 py-5 space-y-5"><div class="flex justify-center"><div data-photo-uploader="true"></div></div><div class="border-b border-gray-200 pb-2.5"><label class="block text-xs font-bold text-gray-500 mb-1">שם</label><input type="text" placeholder="שמך" class="w-full bg-transparent outline-none text-right text-base text-gray-900 placeholder:text-gray-400" style="color:#111827;-webkit-text-fill-color:#111827" value="דנה"/></div><div class="border-b border-gray-200 pb-2.5"><label class="block text-xs font-bold text-gray-500 mb-1">תיאור אישי</label><textarea placeholder="ספר/י קצת על עצמך..." rows="2" class="w-full bg-transparent outline-none text-right resize-none text-base text-gray-900 placeholder:text-gray-400" style="color:#111827;-webkit-text-fill-color:#111827">רצה בבקרים</textarea><p class="text-[10px] text-gray-400 mt-1">10/150</p></div><div><h3 class="text-xs font-bold text-gray-500 mb-2">תגיות אימון</h3><p class="text-[11px] text-gray-400 mb-2.5">אלה התגיות שיופיעו עליך בכרטיס השותף</p><div class="flex flex-wrap gap-2"><button type="button" class="px-3.5 py-2 rounded-full text-sm font-bold border transition-colors bg-[#00ADEF] text-on-brand border-[#00ADEF]">ריצה</button><button type="button" class="px-3.5 py-2 rounded-full text-sm font-bold border transition-colors bg-gray-50 text-gray-600 border-gray-200">סטריט</button></div></div><p class="text-[11px] text-gray-400 text-center pt-1">פרטים אישיים (עיר, משקל, תאריך לידה) נערכים בהגדרות</p></div><div class="p-5 border-t border-gray-100 flex-shrink-0"><button type="button" class="w-full py-3.5 rounded-2xl bg-gradient-to-l from-[#00ADEF] to-[#5BC2F2] text-on-brand font-bold text-sm shadow-lg shadow-cyan-500/20 active:scale-[0.98] transition-transform flex items-center justify-center gap-2 disabled:opacity-60"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>שמור שינויים</button></div></div></div>"`;

