exports[`flag off — byte-identical to the pre-migration markup > ScheduleBuilderDrawer 1`] = `"<div class="fixed inset-0 z-[101] bg-black/40" style="backdrop-filter:blur(4px);opacity:0"></div><div class="fixed bottom-0 left-0 right-0 z-[101] max-w-md mx-auto bg-[#F8FAFC] rounded-t-3xl shadow-2xl flex flex-col" dir="rtl" style="height:92vh;opacity:1;transform:translateY(100%)"><div class="relative flex-shrink-0 flex items-center justify-center py-3 cursor-grab active:cursor-grabbing" style="touch-action:none"><div class="w-10 h-1 bg-slate-300 rounded-full"></div><button type="button" aria-label="סגור" class="absolute left-3 top-2 w-9 h-9 rounded-full bg-white border border-slate-200 flex items-center justify-center shadow-sm active:scale-90 transition-all"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x w-4 h-4 stroke-[2.5] text-gray-900" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="flex-1 overflow-y-auto overscroll-contain px-4 pb-8"><h2 class="text-base font-black text-gray-900 mb-3">בואו נבנה לוז</h2><div class="flex gap-2 mb-4"><button type="button" class="relative flex-1 py-2 rounded-xl text-sm font-black transition-all opacity-40 cursor-not-allowed bg-white text-gray-400 border border-slate-200"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock absolute top-1.5 right-1.5 text-gray-400" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>כוח</button><button type="button" class="relative flex-1 py-2 rounded-xl text-sm font-black transition-all opacity-40 cursor-not-allowed bg-white text-gray-400 border border-slate-200"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock absolute top-1.5 right-1.5 text-gray-400" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>ריצה</button><button type="button" class="relative flex-1 py-2 rounded-xl text-sm font-black transition-all opacity-40 cursor-not-allowed bg-white text-gray-400 border border-slate-200"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock absolute top-1.5 right-1.5 text-gray-400" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>משולב</button></div><div data-slider="true"></div><div class="flex items-center justify-between bg-white rounded-2xl border border-slate-100 px-4 py-3 mb-2"><span class="text-sm font-black text-gray-700">כמה ימים תוכל להתאמן?</span><div class="flex items-center gap-3"><button type="button" class="w-8 h-8 rounded-full bg-slate-100 font-black text-gray-700">−</button><span class="text-base font-black text-gray-900 w-4 text-center">3</span><button type="button" class="w-8 h-8 rounded-full bg-slate-100 font-black text-gray-700">+</button></div></div><div class="mt-4 space-y-2"><p class="text-sm text-gray-500 text-center py-6">אין עדיין מספיק נתונים כדי להציע לוז — פתח תוכנית כוח או ריצה קודם.</p></div><button type="button" disabled="" class="w-full mt-4 py-3 rounded-2xl bg-slate-200 text-slate-400 font-black text-sm cursor-not-allowed">אישור (בקרוב)</button></div></div>"`;

exports[`flag off — byte-identical to the pre-migration markup > SessionDrawer 1`] = `"<div class="fixed inset-0 z-[80] bg-black/40" style="backdrop-filter:blur(4px);opacity:0"></div><div class="fixed bottom-0 left-0 right-0 z-[81] max-w-md mx-auto bg-white dark:bg-slate-900 rounded-t-3xl shadow-2xl flex flex-col" style="height:85vh;transform:translateY(100%)"><div class="relative flex-shrink-0 h-56 rounded-t-3xl overflow-hidden"><div class="w-full h-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center"><span class="text-7xl drop-shadow-md select-none">💪</span></div><div class="absolute inset-0 bg-gradient-to-t from-white dark:from-slate-900 via-black/10 to-transparent"></div><div class="absolute top-3 left-1/2 -translate-x-1/2 w-10 h-1 bg-white/60 rounded-full"></div><button class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/40 backdrop-blur-md flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x text-white" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button><div class="absolute bottom-4 right-4 flex items-center gap-1.5 bg-black/50 backdrop-blur-sm text-white text-[11px] font-bold px-3 py-1.5 rounded-full" dir="rtl"><span>💪</span><span>יום כושר</span></div><div class="absolute top-4 left-4 flex items-center gap-1 bg-gradient-to-r from-cyan-500 to-blue-500 text-white text-[10px] font-black px-2.5 py-1 rounded-full shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check w-3 h-3" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><span>רשמי</span></div></div><div class="flex-1 overflow-y-auto px-5 pt-4 pb-8 space-y-5" dir="rtl"><h2 class="text-xl font-black text-gray-900 dark:text-white leading-tight">אימון בוקר בפארק</h2><div class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock w-4 h-4 text-cyan-500 flex-shrink-0" aria-hidden="true"><path d="M12 6v6l4 2"></path><circle cx="12" cy="12" r="10"></circle></svg><span class="font-semibold">יום שלישי, 20 באוקטובר · 07:00 – 08:00</span></div><div class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg><span class="font-medium">פארק הירקון</span></div><p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">אימון כוח וריצה קלה</p><div class="flex items-center gap-2 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-4 h-4 text-blue-500" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg><span class="font-bold text-gray-700 dark:text-gray-300">4 / 12 משתתפים</span></div><div class="flex items-center justify-between pt-3 border-t border-gray-100 dark:border-gray-800"><div data-attendees="true"></div><span class="text-xs text-gray-500">4 משתתפים</span></div><button class="w-full flex items-center justify-center gap-2 py-3.5 rounded-2xl text-sm font-black transition-all active:scale-[0.97] bg-gradient-to-r from-cyan-500 to-blue-500 text-white shadow-lg shadow-cyan-500/25"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-4 h-4" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>הרשמה לאירוע</button><button class="w-full flex items-center justify-center gap-1.5 py-2 text-xs text-gray-400 dark:text-gray-600 hover:text-red-400 dark:hover:text-red-500 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flag w-3 h-3" aria-hidden="true"><path d="M4 22V4a1 1 0 0 1 .4-.8A6 6 0 0 1 8 2c3 0 5 2 7.333 2q2 0 3.067-.8A1 1 0 0 1 20 4v10a1 1 0 0 1-.4.8A6 6 0 0 1 16 16c-3 0-5-2-8-2a6 6 0 0 0-4 1.528"></path></svg>דיווח על תוכן לא ראוי</button></div></div>"`;

exports[`flag off — byte-identical to the pre-migration markup > SetSavedPlaceSheet 1`] = `"<div class="fixed inset-0 z-[100]" style="background-color:rgba(15, 23, 42, 0.32);backdrop-filter:blur(8px) saturate(140%);-webkit-backdrop-filter:blur(8px) saturate(140%);opacity:0"></div><div dir="rtl" class="kb-sheet fixed bottom-0 inset-x-0 z-[100] rounded-t-3xl shadow-[0_-12px_40px_rgba(0,0,0,0.18)] flex flex-col max-h-[80vh]" style="background-color:rgba(255, 255, 255, 0.92);backdrop-filter:blur(24px) saturate(160%);-webkit-backdrop-filter:blur(24px) saturate(160%);padding-bottom:var(--kb-safe-bottom);transform:translateY(100%)"><div class="flex justify-center pt-3 pb-2"><div class="w-10 h-1 rounded-full bg-gray-300"></div></div><div class="flex items-center justify-between px-5 pb-3"><div class="flex items-center gap-3"><div class="w-9 h-9 rounded-xl bg-cyan-50 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house text-cyan-600" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg></div><div><h2 class="text-base font-black text-gray-900 leading-tight">הגדרת בית</h2><p class="text-[11px] text-gray-500 leading-tight">חפש כתובת ובחר מהרשימה</p></div></div><button type="button" aria-label="סגור" class="w-8 h-8 rounded-full bg-gray-100/80 flex items-center justify-center active:scale-90 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x text-gray-600" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div><div class="px-5 pb-3"><div class="rounded-2xl ring-1 ring-black/5 flex items-center h-12 ps-3 pe-3 gap-2" style="background-color:rgba(255, 255, 255, 0.75);backdrop-filter:blur(12px) saturate(160%);-webkit-backdrop-filter:blur(12px) saturate(160%)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search text-gray-500 shrink-0" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input type="text" placeholder="כתובת הבית שלך..." class="flex-1 bg-transparent border-none outline-none text-sm font-medium text-gray-900 placeholder:text-gray-400 text-right" value=""/></div></div><div class="flex-1 overflow-y-auto px-3 pb-4"><div class="text-center py-10 text-gray-400"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin mx-auto mb-2 opacity-60" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg><p class="text-xs font-medium">הקלד לפחות 3 תווים</p></div></div></div>"`;
