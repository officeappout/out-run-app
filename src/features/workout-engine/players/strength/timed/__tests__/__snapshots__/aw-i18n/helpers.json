formatInfo [{"title":"מה זה AMRAP?","lines":["AMRAP = כמה שיותר סבבים בזמן הקצוב. כאן: 10 דקות.","סבב = 0 התרגילים לפי הסדר. מסיימים אחד ועוברים מיד לבא.","סופרים סבבים מלאים, ובסוף מוסיפים את החזרות של הסבב שלא נגמר.","אין מנוחה קבועה: נחים כשצריך, השעון ממשיך."]},{"title":"מה זה AMRAP?","lines":["AMRAP = כמה שיותר סבבים בזמן הקצוב. כאן: 10 דקות.","סבב = התרגיל. מסיימים אחד ועוברים מיד לבא.","סופרים סבבים מלאים, ובסוף מוסיפים את החזרות של הסבב שלא נגמר.","אין מנוחה קבועה: נחים כשצריך, השעון ממשיך."]},{"title":"מה זה AMRAP?","lines":["AMRAP = כמה שיותר סבבים בזמן הקצוב. כאן: 2 דקות.","סבב = 2 התרגילים לפי הסדר. מסיימים אחד ועוברים מיד לבא.","סופרים סבבים מלאים, ובסוף מוסיפים את החזרות של הסבב שלא נגמר.","אין מנוחה קבועה: נחים כשצריך, השעון ממשיך."]},{"title":"מה זה AMRAP?","lines":["AMRAP = כמה שיותר סבבים בזמן הקצוב. כאן: 60 דקות.","סבב = 4 התרגילים לפי הסדר. מסיימים אחד ועוברים מיד לבא.","סופרים סבבים מלאים, ובסוף מוסיפים את החזרות של הסבב שלא נגמר.","אין מנוחה קבועה: נחים כשצריך, השעון ממשיך."]},{"title":"מה זה AMRAP?","lines":["AMRAP = כמה שיותר סבבים בזמן הקצוב. כאן: 20 דקות.","סבב = 1000 התרגילים לפי הסדר. מסיימים אחד ועוברים מיד לבא.","סופרים סבבים מלאים, ובסוף מוסיפים את החזרות של הסבב שלא נגמר.","אין מנוחה קבועה: נחים כשצריך, השעון ממשיך."]},{"title":"מה זה EMOM?","lines":["EMOM = כל דקה מתחילים משימה חדשה. כאן: 12 פעמים.","מסיימים את המשימה ולוחצים סיימתי — מה שנשאר מהזמן הוא המנוחה.","לא הספקת עד הסוף? רושמים כמה עשית, והמשימה הבאה מתחילה בזמן."]},{"title":"מה זה EMOM?","lines":["EMOM = כל 45 שנ׳ מתחילים משימה חדשה. כאן: 10 פעמים.","מסיימים את המשימה ולוחצים סיימתי — מה שנשאר מהזמן הוא המנוחה.","לא הספקת עד הסוף? רושמים כמה עשית, והמשימה הבאה מתחילה בזמן."]},{"title":"מה זה EMOM?","lines":["EMOM = כל 30 שנ׳ מתחילים משימה חדשה. כאן: 1000 פעמים.","מסיימים את המשימה ולוחצים סיימתי — מה שנשאר מהזמן הוא המנוחה.","לא הספקת עד הסוף? רושמים כמה עשית, והמשימה הבאה מתחילה בזמן."]},{"title":"מה זה EMOM?","lines":["EMOM = כל 120 שנ׳ מתחילים משימה חדשה. כאן: 1 פעמים.","מסיימים את המשימה ולוחצים סיימתי — מה שנשאר מהזמן הוא המנוחה.","לא הספקת עד הסוף? רושמים כמה עשית, והמשימה הבאה מתחילה בזמן."]},{"title":"מה זה טבטה?","lines":["20 שניות עבודה, 10 שניות מנוחה — 8 אינטרוולים.","הטיימר מוביל: עוברים לבד בין עבודה למנוחה, אין צורך ללחוץ.","עובדים בעצימות גבוהה לאורך כל האינטרוול."]},{"title":"מה זה טבטה?","lines":["40 שניות עבודה, 20 שניות מנוחה — 1200 אינטרוולים.","הטיימר מוביל: עוברים לבד בין עבודה למנוחה, אין צורך ללחוץ.","עובדים בעצימות גבוהה לאורך כל האינטרוול."]}]
