# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
# Exception: functions/.env is Firebase Functions v2's own committed runtime
# config file (not a "local secrets" file like the root .env.local above) —
# loaded automatically by the Cloud Functions runtime at deploy time. Only
# contains already-public NEXT_PUBLIC_* values, safe to commit; see its own
# header comment.
!functions/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Cloud Functions ────────────────────────────────────────────────────────────
# Compiled JS output and runtime node_modules are re-generated by the
# Firebase CLI during deployment — never commit them.
functions/lib/
functions/node_modules/

# ── Android / Capacitor ───────────────────────────────────────────────────────
# IDE metadata and Gradle build cache — developer-local, not portable.
android/.idea/
android/build/
android/app/build/

# ── iOS / Capacitor ───────────────────────────────────────────────────────────
ios/App/Pods/
ios/App/App.xcodeproj/xcuserdata/

# ── Native plugins ────────────────────────────────────────────────────────────
plugins/**/build/
plugins/**/node_modules/

# ── Secrets — private keys and service account credentials, never commit ──────
secrets/

# ── Data backups — contain real user/authority data, never commit ─────────────
data/backups/
scripts/_backups/

# ── Signing keys — NEVER commit private keys or keystores ─────────────────────
my-release-key.keystore
*.keystore
*.jks
*-release-key.*
android/keystore.properties
google-services*.json
# GoogleService-Info.plist is intentionally committed so CI/TestFlight builds work.
firebase-key.json
android/keystore.properties

# Settings backups
.claude/settings.json.bak*

# Cloud Functions vendor mirror — fully regenerated by
# functions/scripts/vendor-copy-geo-discovery.js on every `npm run build`.
# scripts/geo-discovery-routes.ts stays the single source of truth; never
# commit this generated copy.
functions/src/_vendor/

# Firestore emulator debug log
firestore-debug.log
