# ============================================================================
# OUT-RUN — Environment Variables Template
# ============================================================================
# Copy this file to `.env.local` and fill in the values you need.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored (`.gitignore` has `.env*.local`) so secrets
# never leave your machine. `vercel env pull` will OVERWRITE this file
# wholesale — keep this `.env.example` as the canonical reference so you
# can rebuild `.env.local` after a sync.
#
# Every key referenced in this template was discovered with:
#   rg "process\.env\." src
# Keep them in sync if you add a new variable.
# ============================================================================


# ── REQUIRED for the app to render ──────────────────────────────────────────
# Without this, every Mapbox component throws
# `An API access token is required` and the entire map blanks.
# Pull from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Firebase App Check — public reCAPTCHA Enterprise site key (production).
# Required in production for App Check enforcement on Firestore/Storage.
# Pull from: https://console.firebase.google.com → App Check → reCAPTCHA Enterprise
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Firebase Cloud Messaging — Web Push VAPID key (Web browser push notifications).
# Required for push notifications in web browsers (Android Chrome, desktop, iOS PWA).
# Pull from: Firebase Console → Project Settings → Cloud Messaging →
#            Web Push certificates → Generate key pair → copy the "Key pair" value.
NEXT_PUBLIC_FCM_VAPID_KEY=


# ── OPTIONAL (dev-only / feature flags) ─────────────────────────────────────
# App Check debug token — bypasses reCAPTCHA in development. Get one from
# the Firebase console (App Check → Apps → Manage debug tokens).
# Leave blank in production.
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Set to 'true' on native iOS/Android development builds to use the
# Firebase App Check debug provider instead of DeviceCheck/Play Integrity.
# This allows callable Cloud Functions (enforceAppCheck: true) to work
# during Xcode/Android Studio dev builds without a real attestation token.
# NEVER set this in production — omit entirely or leave blank.
# Also requires: register a debug token in Firebase Console → App Check →
#   iOS app → Manage debug tokens, then add FIRAppCheckDebugToken as an
#   Xcode scheme environment variable with that UUID.
NEXT_PUBLIC_APP_CHECK_DEBUG=

# Comma-separated emails treated as root admins by `feature-flags.ts`.
# Optional — leave blank to use the Firestore-side role table only.
NEXT_PUBLIC_ROOT_ADMIN_EMAILS=

# Bunny CDN — public-side IDs (browser uses these to build asset URLs).
# Falls back to the server-only equivalents below if blank.
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=

# The app's public domain — THE single switch for a domain move
# (src/lib/config/domain.ts). Bare host, no https://. Every share link,
# short link, QR, admin./portal. host check, OG metadataBase and the native
# shell's server.url derive from it. Changing it needs a redeploy.
NEXT_PUBLIC_APP_DOMAIN=outrun.co.il
# Previous domains that still serve the app (comma-separated), so admin./
# portal. routing and own-site referrer checks keep accepting them.
NEXT_PUBLIC_APP_LEGACY_DOMAINS=

# Optional override for the short-link base only (SHORT_LINK_DOMAIN in
# marketing-links.service.ts). Leave BLANK so it follows
# NEXT_PUBLIC_APP_DOMAIN — if it's set in Vercel, it must be changed (or
# removed) on domain-switch day too.
NEXT_PUBLIC_SHORT_LINK_DOMAIN=

# Sentry DSN (error monitoring, web only — Stage 1). Public by design (a DSN
# only accepts events, it can't read anything back), but still an env var —
# never hardcoded — so it can be set per-environment in Vercel and rotated
# without a code change. Blank/unset = Sentry.init() no-ops, nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=


# ── SERVER-ONLY (never exposed to the browser, no NEXT_PUBLIC_ prefix) ──────
# Firebase Admin SDK service account JSON (single-line, escaped).
# Used by `src/lib/firebase-admin.ts` for server-side auth/Firestore/RBAC.
FIREBASE_PROJECT_ID=appout-1
FIREBASE_SERVICE_ACCOUNT_KEY=

# Symmetric secret used to sign the admin session cookie. Any random
# 32+ char string is fine in dev; rotate in production.
SESSION_COOKIE_SECRET=

# Salt for the one-way IP hash on `/api/links/[id]/click`'s per-click
# analytics record (marketing_links/{id}/clicks). Never persist a raw IP —
# see hashIp() in that route. Any random string is fine; rotating it just
# breaks continuity of the (non-critical) ip-based dedup, nothing else.
LINK_CLICK_IP_SALT=

# HMAC secret for personal calendar-feed URLs (/api/calendar/t/{uid}.{mac}).
# MUST be >= 32 bytes of randomness — generate yourself, e.g.
# `openssl rand -base64 48`. Set in Vercel (Production + Preview). Missing or
# short = fail-closed: POST /api/calendar/token -> 503, feed -> 404 (the
# calendar-sync button is disabled; nothing leaks). Rotating it invalidates
# every issued feed URL (there is no per-user revocation).
CALENDAR_FEED_SECRET=

# Bunny CDN — server-side credentials. The `bunny.config.ts` reader
# prefers the `NEXT_PUBLIC_*` variants for browser code and falls back
# to these for API routes.
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=

# Admin costs dashboard (/admin/costs) — billing connectors. All optional:
# a missing one shows "לא מחובר" with setup steps on the page. Server-only
# secrets (Vercel env, Production) — never NEXT_PUBLIC_. Setup steps per
# connector: src/lib/costs/connector-meta.ts. The daily refresh reuses
# AI_REVIEW_CRON_SECRET (no new secret).
ANTHROPIC_ADMIN_KEY=
GCP_BILLING_EXPORT_TABLE=
GCP_BILLING_SA_KEY=
VERCEL_BILLING_TOKEN=
VERCEL_TEAM_ID=
BUNNY_ACCOUNT_API_KEY=
GITHUB_BILLING_TOKEN=
GITHUB_BILLING_ORG=

# Sentry build-time source-map upload (next.config.mjs's withSentryConfig).
# SENTRY_AUTH_TOKEN is a secret (Sentry org settings → Auth Tokens, scope:
# project:releases) — build-only, never NEXT_PUBLIC_, never committed.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Weather (/api/weather). WEATHER_PROVIDER: 'open-meteo' (default) or 'ims'.
# WEATHER_API_KEY = Open-Meteo commercial key. IMS_API_TOKEN = Israel Meteorological
# Service Envista API token (request from ims@ims.gov.il) — server-only secret, never
# NEXT_PUBLIC_. WEATHER_PROVIDER=ims without a token falls back to open-meteo.
WEATHER_PROVIDER=
WEATHER_API_KEY=
IMS_API_TOKEN=


# ── AUTO-INJECTED by Vercel (do NOT set manually) ───────────────────────────
# `vercel env pull` writes this; the build picks it up automatically.
# VERCEL_OIDC_TOKEN=
