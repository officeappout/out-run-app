{
  "name": "out-run-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "upload-media": "npx tsx scripts/upload-local-media.ts",
    "_comment_deploy": "── Deployment ── Run 'deploy' to push web app to Vercel (updates the live iOS/Android content). 'cap:sync' is for native plugin/config changes only — it does NOT update web content.",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "_comment_cap": "── Capacitor ── 'cap:sync' only copies the offline-shell fallback + syncs native plugins. Web content comes from server.url (Vercel). Run 'deploy' first if web code changed.",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "_comment_dev": "── Dev builds ── Use cap:sync:ios:dev for debug App Check (account deletion testing). Run cap:sync:ios to restore production config before committing.",
    "cap:sync:ios:dev": "APP_CHECK_DEBUG=true npx cap sync ios",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "_comment_full": "── Full pipeline ── Use these when you want to deploy web + sync native in one shot.",
    "ship:ios": "next build && vercel --prod && npx cap sync ios",
    "ship:android": "next build && vercel --prod && npx cap sync android",
    "ship": "next build && vercel --prod && npx cap sync",
    "_comment_preflight": "── Pre-flight ── Run before every TestFlight / release build to catch missing native config (GoogleService-Info.plist, REVERSED_CLIENT_ID, SHA fingerprints, etc.).",
    "preflight": "node scripts/preflight-native-check.mjs",
    "preflight:testflight": "node scripts/preflight-native-check.mjs && npm run cap:sync:ios",
    "postinstall": "patch-package"
  },
  "dependencies": {
