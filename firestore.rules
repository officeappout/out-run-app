rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Root admin — hardcoded emails, case-insensitive.
    // Uses auth token directly (no Firestore read), so it never fails.
    function isRootAdmin() {
      return isAuthenticated() &&
        request.auth.token.email.matches('(?i)^(david|office)@appout\\.co\\.il$');
    }

    // DB-backed admin — mirrors the multi-field check in resolveIdentity (firebase-admin.ts)
    // and checkUserRole (auth.service.ts).
    //
    // The app stores admin flags under `users/{uid}.core.*` (NOT as a top-level `role`
    // field). This helper reads all relevant fields so that any path that grants
    // Super Admin or System Admin privileges on the client also satisfies Firestore rules.
    //
    // Firestore caches repeated get() calls to the same document within a single request
    // evaluation, so calling getUserDoc() multiple times is equivalent to one read.
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isRootAdmin() ||
        (request.auth != null && (
          getUserDoc().role == 'admin' ||
          getUserDoc().get('core', {}).get('role', '') == 'admin' ||
          getUserDoc().get('core', {}).get('isSuperAdmin', false) == true ||
          getUserDoc().get('core', {}).get('isSystemAdmin', false) == true
        ));
    }

    // True when the authenticated user is an admin of a specific community group
    // (role: 'admin' in community_groups/{groupId}/members/{uid}).
    // OUT admins (isAdmin()) bypass this check.
    function isGroupAdmin(groupId) {
      return isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/community_groups/$(groupId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/community_groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // True when the authenticated user is the original creator (owner) of a group.
    // Owners have elevated rights over admins: only they can demote admins or remove admins.
    function isGroupOwner(groupId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/community_groups/$(groupId)).data.get('createdBy', '') == request.auth.uid;
    }

    // Tenant isolation — checks Custom Claim `tenantId` on the auth token.
    // Set via Admin SDK when assigning a user to a tenant.
    // Root/DB admins bypass tenant checks.
    function hasTenant(tenantId) {
      return isRootAdmin() || isAdmin() ||
        (isAuthenticated() && request.auth.token.tenantId == tenantId);
    }

    // ============================================================
    // USER-DOC PROTECTED-FIELD HELPERS
    //
    // The application reads admin/role flags from `users/{uid}.core.*`
    // (see src/features/admin/services/auth.service.ts → checkUserRole).
    // Because `affectedKeys()` is shallow, any owner could previously
    // self-promote by writing `{'core.isSuperAdmin': true}`. These helpers
    // close that hole by comparing each protected field byte-for-byte
    // before/after the update. Only writes that leave EVERY protected
    // field unchanged are allowed for non-admin owners.
    //
    // Admins (Admin SDK in Cloud Functions, or root/DB admin via console)
    // bypass these helpers via the separate `allow write` line below.
    // ============================================================

    // Group A — admin/role flags. These can ONLY be flipped by:
    //   • A Cloud Function using the Admin SDK (bypasses rules), or
    //   • A root/DB admin in the Firebase console.
    function noAdminFieldsChanged() {
      return request.resource.data.get('role', '')
             == resource.data.get('role', '')
          && request.resource.data.get('core', {}).get('role', '')
             == resource.data.get('core', {}).get('role', '')
          && request.resource.data.get('core', {}).get('isSuperAdmin', false)
             == resource.data.get('core', {}).get('isSuperAdmin', false)
          && request.resource.data.get('core', {}).get('isSystemAdmin', false)
             == resource.data.get('core', {}).get('isSystemAdmin', false)
          && request.resource.data.get('core', {}).get('isVerticalAdmin', false)
             == resource.data.get('core', {}).get('isVerticalAdmin', false)
          && request.resource.data.get('core', {}).get('isTenantOwner', false)
             == resource.data.get('core', {}).get('isTenantOwner', false)
          && request.resource.data.get('core', {}).get('isApproved', false)
             == resource.data.get('core', {}).get('isApproved', false)
          && request.resource.data.get('core', {}).get('managedVertical', '')
             == resource.data.get('core', {}).get('managedVertical', '');
    }

    // Group B — tenant/unit assignment. Owned by `validateAccessCode`
    // Cloud Function and admin tooling. Owners cannot self-assign.
    //
    // FIXED 01.09.2026 (found while building military-persona self-declared
    // affiliation, see docs/research/military-persona-unified-architecture.md):
    // the old "initial-write allowance" (client may write any value into
    // tenantId/unitId/unitPath/tenantType while the field is still at its
    // default) applied to EVERY client, not just admins — a regular user
    // could self-assign an arbitrary tenantId/unitId with a raw client write,
    // and functions/src/leaderboard.ts trusts core.tenantId/unitId with zero
    // verification when bucketing real competitive leaderboards. That let
    // anyone place themselves in any unit's leaderboard without ever
    // redeeming a real access code.
    //
    // Now: the initial-write allowance for tenantId/tenantType/unitId/unitPath
    // requires isAdmin() — this is exactly what invitation.service.ts's
    // admin-invitation-acceptance flow already needs (client-side updateDoc,
    // called by an admin) and exactly what a regular self-assigning user
    // lacks. validateAccessCode (Admin SDK, Cloud Function) is unaffected —
    // Admin SDK bypasses these rules entirely regardless of this change.
    // Once a non-default value is stored, a NON-admin can never change it via
    // a client write — unchanged from before. (Admins retain their existing
    // blanket override via the `match /{document=**} { allow write: if
    // isAdmin(); }` fallback at the bottom of this file, same as every other
    // protected field group here — that's pre-existing architecture, not
    // something this fix touches.)
    //
    // Note: authorityId keeps its original (pre-fix) behavior — its primary
    // lock is that onboarding-sync does NOT include it in its payload; writes
    // always route through /api/user/update-authority (Admin SDK). That's a
    // different field with a different risk profile (city self-declaration,
    // not real-unit-leaderboard placement) — not in scope for this fix.
    function noTenantFieldsChanged() {
      let cur = resource.data.get('core', {});
      let nxt = request.resource.data.get('core', {});
      return (cur.get('tenantId', '') == nxt.get('tenantId', '')
              || (cur.get('tenantId', '') == '' && isAdmin()))
          && (cur.get('tenantType', '') == nxt.get('tenantType', '')
              || (cur.get('tenantType', '') == '' && isAdmin()))
          && (cur.get('unitId', '') == nxt.get('unitId', '')
              || (cur.get('unitId', '') == '' && isAdmin()))
          && (cur.get('unitPath', []) == nxt.get('unitPath', [])
              || (cur.get('unitPath', []).size() == 0 && isAdmin()))
          && (cur.get('authorityId', '') == ''    || cur.get('authorityId', '')    == nxt.get('authorityId', ''));
    }

    // Group C — game-integrity / progression. Locking these prevents a
    // user from awarding themselves coins/levels via direct Firestore
    // writes from the browser console.
    //
    // The ONLY authorized writer for these fields is the
    // `awardWorkoutXP` Callable Cloud Function ("the Guardian"), which
    // uses the Admin SDK and therefore bypasses these rules. See
    // functions/src/awardWorkoutXP.ts for the server-side validation
    // (auth required, per-call delta caps, server-recomputed level).
    //
    // INITIAL-WRITE ALLOWANCE: when the stored doc has no `progression` map
    // at all (guest shell doc created by session-token/confirm before onboarding
    // completes), the client may write the initial seed values. This eliminates
    // the race between the Admin-SDK shell write and the client onboarding-sync
    // call without loosening the lock on any already-earned value.
    // Once `progression` exists in the stored doc, only awardWorkoutXP can
    // change coins / globalLevel / globalXP.
    function noGameIntegrityFieldsChanged() {
      let stored   = resource.data.progression;
      let incoming = request.resource.data.progression;
      return !('progression' in resource.data)
          || (incoming.globalLevel == stored.globalLevel
           && incoming.globalXP   == stored.globalXP
           && incoming.coins      == stored.coins);
    }

    // Group E — social graph membership. `social.groupIds` is the trusted
    // source that backs the presence `group` scope (who can see you on the
    // map when mode='group'). Because the presence read rule derives access
    // from this field, a client that could self-write arbitrary groupIds
    // could spoof membership in any group and read members' locations.
    //
    // The ONLY authorized writer for social.groupIds is the Admin SDK via
    // the `/api/social/group-membership` Next.js route, which is called by
    // joinGroup / leaveGroup / createGroup in group.service.ts after the
    // community_groups/{groupId}/members/{uid} write has already succeeded.
    // Admins (Admin SDK) bypass these rules entirely.
    function noSocialGroupIdsChanged() {
      return request.resource.data.get('social', {}).get('groupIds', [])
             == resource.data.get('social', {}).get('groupIds', []);
    }

    // Group D — passive sensor fields on `dailyActivity`. Native Phase
    // (Apr 2026): HealthKit / Health Connect samples are written ONLY
    // by the `ingestHealthSamples` Cloud Function (Admin SDK bypasses
    // these rules). Owners may still freely mutate manual-workout fields
    // on the same doc (categories.strength.minutes, etc.), but the
    // server-managed counters below are read-only from the client.
    //
    // We compare against the previous resource value when the doc exists,
    // and against 0 / serverTimestamp() when it does not — so a brand new
    // doc created by manual-workout client code can leave these fields
    // unset (== default) without tripping the guard.
    function noPassiveActivityFieldsChanged() {
      return request.resource.data.get('passiveSteps', 0)
             == resource.data.get('passiveSteps', 0)
          && request.resource.data.get('passiveCalories', 0)
             == resource.data.get('passiveCalories', 0)
          && request.resource.data.get('passiveActiveMinutes', 0)
             == resource.data.get('passiveActiveMinutes', 0)
          && request.resource.data.get('passiveXpAwardedToday', 0)
             == resource.data.get('passiveXpAwardedToday', 0);
    }

    // Null-safe read of user_memberships/{uid}.groupIds.
    // get() on a non-existent path returns data == null; calling .get() on
    // null would throw a TypeError and deny the rule.  This helper guards
    // against that for users who have not yet been backfilled.
    function memberGroupIds(uid) {
      let d = get(/databases/$(database)/documents/user_memberships/$(uid)).data;
      return d != null ? d.get('groupIds', []) : [];
    }

    // Null-safe read of userAge/{uid}.ageGroup.
    // userAge is a ~50-byte doc written exclusively by Admin SDK via
    // /api/user/complete-profile.  Returns 'minor' when the doc is
    // missing — safe default; unbackfilled users are always restricted.
    function getUserAgeGroup(userId) {
      let d = get(/databases/$(database)/documents/userAge/$(userId)).data;
      return d != null ? d.get('ageGroup', 'minor') : 'minor';
    }

    // core.ageGroup and core.birthDate are computed server-side.
    // Clients must NEVER write them directly — the only authorized
    // path is /api/user/complete-profile (Admin SDK bypass).
    function noLockedCoreFieldsChanged() {
      let cur = resource.data.get('core', {});
      let nxt = request.resource.data.get('core', {});
      return cur.get('ageGroup',  '') == nxt.get('ageGroup',  cur.get('ageGroup',  ''))
          && cur.get('birthDate', null) == nxt.get('birthDate', cur.get('birthDate', null));
    }

    // ============================================================
    // USERS — owner reads/writes own doc, admins read/write all,
    //         cross-user read gated by core.discoverable == true
    //
    // SECURITY (Fortress Phase — Deep Privilege Lockdown):
    //   The owner can NEVER mutate role/admin/tenant/progression flags.
    //   See helpers above for the exact field list and the Cloud-Function
    //   migration note for game-integrity fields.
    //   Admin role assignment must be done exclusively via:
    //     - Cloud Functions (Admin SDK bypasses these rules), or
    //     - Manual writes by a root/DB admin.
    // ============================================================
    match /users/{userId} {
      // READ — owner, admins, or any auth user when the profile opted into discovery.
      allow read: if isOwner(userId)
                  || isRootAdmin() || isAdmin()
                  || (isAuthenticated() && resource.data.core.discoverable == true);

      // CREATE — owner can create their own doc, but cannot self-assign
      // any role/admin flag at creation time, and cannot set the
      // server-computed identity fields (ageGroup, birthDate).
      allow create: if isOwner(userId)
                    && !('role' in request.resource.data)
                    && !('ageGroup'  in request.resource.data.get('core', {}))
                    && !('birthDate' in request.resource.data.get('core', {}))
                    && request.resource.data.get('core', {}).get('isSuperAdmin', false) == false
                    && request.resource.data.get('core', {}).get('isSystemAdmin', false) == false
                    && request.resource.data.get('core', {}).get('isVerticalAdmin', false) == false
                    && request.resource.data.get('core', {}).get('isTenantOwner', false) == false
                    && request.resource.data.get('core', {}).get('isApproved', false) == false
                    && request.resource.data.get('core', {}).get('role', '') == ''
                    && request.resource.data.get('core', {}).get('managedVertical', '') == ''
                    // Same fix as noTenantFieldsChanged() (Group B, below) —
                    // the create path had NO guard on these fields at all
                    // before this fix, not even an "initial-write allowance".
                    && (isAdmin() || request.resource.data.get('core', {}).get('tenantId', '') == '')
                    && (isAdmin() || request.resource.data.get('core', {}).get('tenantType', '') == '')
                    && (isAdmin() || request.resource.data.get('core', {}).get('unitId', '') == '')
                    && (isAdmin() || request.resource.data.get('core', {}).get('unitPath', []).size() == 0);

      // UPDATE — owner may write everything EXCEPT the four protected
      // groups (admin/role, tenant, game-integrity, social-group-ids). The
      // Guardian Cloud Function uses the Admin SDK to award XP/coins/calories
      // and bypasses Group C; /api/social/group-membership (Admin SDK) owns
      // Group E. See the helper comments above for authorized write paths.
      allow update: if isOwner(userId)
                    && noAdminFieldsChanged()
                    && noTenantFieldsChanged()
                    && noGameIntegrityFieldsChanged()
                    && noSocialGroupIdsChanged()
                    && noLockedCoreFieldsChanged();

      // DELETE — owner can delete their own doc.
      allow delete: if isOwner(userId);

      // Admins (root or DB-backed) keep full read/write on the user doc,
      // including all protected groups — this is how admins are
      // promoted/demoted and how tenants are assigned in tooling.
      allow write: if isRootAdmin() || isAdmin();

      // ──────────────────────────────────────────────────────────────
      // notification_clicks — push CTR analytics sub-collection.
      //
      // Written by the Capacitor push listener in src/lib/native/push.ts
      // (notificationActionPerformed → addDoc) whenever the user taps an
      // OS-delivered notification banner. Each doc carries:
      //   { messageId, channel, authorityId, clickedAt }
      //
      // Admins aggregate clicks via a collectionGroup query:
      //   collectionGroup('notification_clicks').where('messageId', '==', id)
      //
      // We declare this rule EXPLICITLY (not relying on the wildcard
      // below) so the collectionGroup query path is unambiguously
      // authorized at the security-rules level. The wildcard at depth
      // /{allPaths=**} also matches, but having a named rule for the
      // exact sub-collection makes intent clear and survives any
      // future narrowing of the wildcard.
      //
      // SECURITY: owners may only CREATE (no update / delete) so that
      // clients cannot inflate or rewrite their own CTR history.
      // ──────────────────────────────────────────────────────────────
      match /notification_clicks/{clickId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read:   if isRootAdmin() || isAdmin();
      }

      // Recursive wildcard — covers ALL sub-collections at ANY depth under users/{userId}.
      // This is required for nested paths like:
      //   exerciseHistory/{exerciseId}/sessions/{sessionId}   (getExerciseTrend)
      //   dailyStats/steps/sessions/{date}                     (future)
      // Without this rule, queries on 3+ level sub-collections fail with
      // "Missing or insufficient permissions".
      //
      // IMPORTANT: uses /{subCollection}/{subPaths=**} (NOT /{allPaths=**}).
      // The single-segment {subCollection} prefix forces at least ONE path segment
      // after userId, so this rule does NOT match users/{userId} itself. If written
      // as /{allPaths=**}, the ** wildcard matches zero segments and the unconstrained
      // `allow write` would bypass every noAdminFieldsChanged / noSocialGroupIdsChanged
      // / noGameIntegrityFieldsChanged guard on the user doc.
      match /{subCollection}/{subPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isRootAdmin() || isAdmin();
      }
    }

    // ============================================================
    // ACTIVITY — daily activity logs, streaks (owned by user)
    // docId format: {userId}_{date}
    //
    // Two rule paths to cover both single-doc and collection-query access:
    //
    //   read  → resource.data.userId == uid
    //           Allows collection queries (WHERE userId == uid) because
    //           Firestore can tie this field check to the query's WHERE clause.
    //           Also covers single-doc reads when the doc exists.
    //
    //   write → request.resource.data.userId == uid
    //           Validates the incoming payload for creates and updates.
    //
    //   Both paths fall back to the docId prefix check (uid + '_') so that
    //   reads on non-existent docs and legacy paths still work.
    // ============================================================
    match /dailyActivity/{docId} {
      allow read, write: if isRootAdmin() || isAdmin();

      // Leaderboard queries (steps mode: WHERE authorityId == scopeId, orderBy steps)
      // must read across multiple users' dailyActivity docs. The owner-only rules
      // below still apply for all other client reads; this line only widens the
      // read gate — writes remain strictly owner-scoped and passive-field-protected.
      allow read: if isAuthenticated();

      // Read: field check (enables collection queries) OR docId prefix
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (docId.size() > request.auth.uid.size() &&
         docId[0:request.auth.uid.size()] == request.auth.uid &&
         docId[request.auth.uid.size():request.auth.uid.size()+1] == '_')
      );

      // CREATE — owner check + passive fields must start at zero (or
      // be omitted). The ingestHealthSamples Cloud Function bypasses
      // this rule via Admin SDK, so server-side creation can still
      // populate passive counters directly.
      allow create: if isAuthenticated()
        && (
          request.resource.data.userId == request.auth.uid ||
          (docId.size() > request.auth.uid.size() &&
           docId[0:request.auth.uid.size()] == request.auth.uid &&
           docId[request.auth.uid.size():request.auth.uid.size()+1] == '_')
        )
        && request.resource.data.get('passiveSteps', 0) == 0
        && request.resource.data.get('passiveCalories', 0) == 0
        && request.resource.data.get('passiveActiveMinutes', 0) == 0
        && request.resource.data.get('passiveXpAwardedToday', 0) == 0;

      // UPDATE — owner check + passive sensor fields must not change.
      // Manual-workout client code can still freely update
      // categories.*.minutes, steps, calories, etc.
      allow update: if isAuthenticated()
        && (
          request.resource.data.userId == request.auth.uid ||
          (docId.size() > request.auth.uid.size() &&
           docId[0:request.auth.uid.size()] == request.auth.uid &&
           docId[request.auth.uid.size():request.auth.uid.size()+1] == '_')
        )
        && noPassiveActivityFieldsChanged();

      // DELETE — owner only.
      allow delete: if isAuthenticated()
        && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          (docId.size() > request.auth.uid.size() &&
           docId[0:request.auth.uid.size()] == request.auth.uid &&
           docId[request.auth.uid.size():request.auth.uid.size()+1] == '_')
        );
    }

    // dailyProgress — same docId format: {userId}_{date}
    // Same dual-path pattern as dailyActivity above.
    match /dailyProgress/{docId} {
      allow read, write: if isRootAdmin() || isAdmin();

      allow read: if isAuthenticated() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (docId.size() > request.auth.uid.size() &&
         docId[0:request.auth.uid.size()] == request.auth.uid &&
         docId[request.auth.uid.size():request.auth.uid.size()+1] == '_')
      );

      allow write: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        (docId.size() > request.auth.uid.size() &&
         docId[0:request.auth.uid.size()] == request.auth.uid &&
         docId[request.auth.uid.size():request.auth.uid.size()+1] == '_')
      );
    }

    // streaks — docId == uid
    // Reads are open to all authenticated users so that leaderboard queries
    // (ranking.service.ts streak mode: WHERE authorityId == scopeId) can
    // aggregate across multiple users' streak docs without permission errors.
    // Writes remain owner-only (isOwner checks uid == docId) plus admins.
    match /streaks/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(docId) || isRootAdmin() || isAdmin();
    }

    // ============================================================
    // HEALTH SAMPLES — raw HealthKit / Health Connect samples
    // (Native Phase, Apr 2026).
    //
    // Path: healthSamples/{userId}/{YYYY-MM-DD}/{sampleUUID}
    //
    // Writes are SERVER-ONLY: only the `ingestHealthSamples` Cloud
    // Function (Admin SDK bypasses these rules) may write here. This
    // protects the dedupe ledger from client tampering and ensures
    // every sample is validated + clamped before storage.
    //
    // Reads are owner-only (for debugging / future history views).
    // ============================================================
    match /healthSamples/{userId}/{date}/{sampleUUID} {
      allow read: if isOwner(userId) || isRootAdmin() || isAdmin();
      allow write: if isRootAdmin() || isAdmin();
    }
    // Parent doc holding the per-date subcollections — no client writes.
    match /healthSamples/{userId} {
      allow read: if isOwner(userId) || isRootAdmin() || isAdmin();
      allow write: if isRootAdmin() || isAdmin();
    }

    // ============================================================
    // UTS — USER SCHEDULE (Phase 1)
    // Doc ID pattern: {userId}_{YYYY-MM-DD}
    // Users can only read/write their own schedule documents.
    // Admins can read/write all (for support & analytics).
    // Uses substring check: docId must start with "uid_".
    // ============================================================
    match /userSchedule/{docId} {
      allow read, write: if isRootAdmin() || isAdmin() ||
        (isAuthenticated() &&
         docId.size() > request.auth.uid.size() &&
         docId[0:request.auth.uid.size()] == request.auth.uid &&
         docId[request.auth.uid.size():request.auth.uid.size()+1] == '_');
    }

    // ============================================================
    // WORKOUTS — owner access via userId field on document
    // ============================================================
    match /workouts/{docId} {
      allow read, write: if isRootAdmin() || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // ============================================================
    // SHARED WORKOUTS — public read for deep links,
    // authenticated create for sharing
    // ============================================================
    match /sharedWorkouts/{docId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.creatorId;
      allow write: if isRootAdmin() || isAdmin();
    }

    // ============================================================
    // ANALYTICS — משתמש מחובר כותב אירועים
    // ============================================================
    match /analytics_events/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // ============================================================
    // PUSH_EVENTS — notification-engine measurement (Wave 1).
    // Server (Admin SDK, bypasses rules) writes push_sent/post_push_outcome —
    // NOT reachable via these rules at all. Client may create ONLY the 2
    // event types it actually writes (push.ts), for itself only, and ONLY
    // with the exact field set each writes — a field-level allowlist so a
    // client can never smuggle in delivered/goalCompleted/variantId/etc.
    // (fields real only on the server-only event types) onto its own doc.
    // push_dismissed is intentionally NOT in the allowed set — no client
    // code writes it yet (see push-events.service.ts header comment).
    // ============================================================
    match /push_events/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && (
          (request.resource.data.eventType == 'push_opened'
            && request.resource.data.keys().hasOnly(['pushId', 'uid', 'eventType', 'channel', 'openedAt']))
          ||
          (request.resource.data.eventType == 'landing_screen'
            && request.resource.data.keys().hasOnly(['pushId', 'uid', 'eventType', 'channel', 'landingPath', 'loggedAt']))
        );
    }

    // ============================================================
    // ACHIEVEMENTS — achievement definitions (public read, admin write)
    // Seeded via scripts/seed-achievements.ts.
    // Users read definitions to display locked/unlocked states.
    // ============================================================
    match /achievements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // CONTENT — קריאה ציבורית (תרגילים, תוכניות, רמות, ציוד)
    // ============================================================
    match /exercises/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /levels/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /personas/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gear_definitions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gym_equipment/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /outdoorBrands/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // RUNNING ENGINE — תבניות אימוני ריצה + תוכניות + קונפיג
    // Public read so onboarding can generate plans for anonymous users.
    // ============================================================
    match /runWorkoutTemplates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /runProgramTemplates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // ONBOARDING & QUESTIONNAIRE — קריאה ציבורית, כתיבה לאדמין
    // ============================================================
    match /onboarding_questions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /onboarding_answers/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // PROGRESSION ENGINE — קריאה ציבורית, כתיבה לאדמין
    // ============================================================
    match /progression_rules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SECURITY (C2 — Public Write defense):
    //   These collections were previously world-writable to support a
    //   "Master Evolution Sync" job. That assumption was wrong — Cloud
    //   Functions and Admin SDK calls bypass Firestore rules entirely, so
    //   server-side syncs do NOT require client-facing write permissions.
    //   Any anonymous or authenticated client could overwrite the workout
    //   engine's level/progression configuration → app-wide content corruption.
    //
    //   New policy:
    //     - read:  any authenticated user (the workout engine reads these client-side)
    //     - write: admins only (root or DB-backed)
    //   Server-side migration scripts continue to work via the Admin SDK.
    match /program_level_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isRootAdmin() || isAdmin();
    }

    match /programLevelSettings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isRootAdmin() || isAdmin();
    }

    match /level_equivalence_rules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // APP CONFIG — הגדרות גלובליות (XP multipliers וכו׳)
    // ============================================================
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // WORKOUT METADATA — תבניות, הודעות, תיאורים + תתי-אוספים
    // ============================================================
    match /workoutMetadata/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{subCollection}/{subDocId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Root-level metadata collections (used by workout-metadata.service)
    match /workoutTitles/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{sub}/{subDocId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /smartDescriptions/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{sub}/{subDocId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /motivationalPhrases/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{sub}/{subDocId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Workout content fragments & titles
    match /workout_content_fragments/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /workout_funny_titles/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /workout_titles_creative/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /workout_time_contexts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /workout_focus_fragments/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /time_contexts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /focus_descriptions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // PARKS, ROUTES, FACILITIES
    // ============================================================
    match /parks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /facilities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // ROUTE-COLLECTION AUTHORITY GUARD — Stage 2.5 (route-enrichment-
    // pipeline plan, .claude/plans/route-enrichment-pipeline-kickoff-
    // vast-pelican.md). STAGED 16.08.2026, NOT YET DEPLOYED — written +
    // reviewed pending David's explicit go per that plan's Stage 2.5 gate.
    //
    // Client-SDK/admin-UI defense-in-depth only — cannot stop Admin-SDK
    // script writes (those bypass rules entirely by design). Primary
    // enforcement for scripts is src/lib/route-collections/validate.ts's
    // buildValidatedDoc chokepoint (Stage 1B), already live in application
    // code for the 4 migrated call sites.
    //
    // `is string` guards matter here: a field value of `null` is NOT equal
    // to `''`, so a naive `!= ''` check alone would let a null-valued
    // authorityId slip straight through. Found during the Stage 2.5
    // write-path audit: official-route-broadcaster.ts intentionally writes
    // `authorityId: null` on street_segments docs broadcast from a route
    // that itself has no authorityId (confirmed live 16.08.2026: 156 of 183
    // official_routes docs have no authorityId at all).
    //
    // ⚠️ WRITE-PATH AUDIT FINDING — DO NOT DEPLOY street_segments' create
    // guard until this is resolved: applying hasResolvedAuthority() to
    // street_segments as currently written WOULD BREAK
    // official-route-broadcaster.ts's broadcast for any of those 156 routes
    // (it's fire-and-forget with a swallowed .catch(), so the failure would
    // be SILENT to the admin — exactly the "PERMISSION-DENIED silently"
    // failure mode axioms.md §17 already warns about). Fix
    // official-route-broadcaster.ts to resolve/require authorityId before
    // broadcasting (or explicitly skip+warn when absent, not write null),
    // OR backfill the 156 legacy official_routes docs' authorityId first
    // (bulkAssignAuthority already exists for exactly this — not yet run).
    // Audited SAFE to deploy as-is: official_routes, curated_routes
    // (InventoryService's migrated saveRoutes/saveCuratedRoutes/updateRoute
    // already guarantee authorityId via the Stage 1B chokepoint before any
    // write reaches here — this rule is redundant-but-safe defense-in-depth
    // for those two), climb_segments (only writer is an Admin-SDK script,
    // bypasses rules; moderation.service.ts's approve/reject only updates
    // status, never touches authorityId/city, so the grandfather clause
    // makes it a no-op either way), route_adjacency (cityName always
    // set by recomputeRouteAdjacencyForCity — see its own match block).
    // route-stitching.service.ts's curated_routes writer also audited safe
    // — authorityId is a required, always-set function parameter.
    // ============================================================
    function hasResolvedAuthority() {
      return request.resource.data.get('authorityId', '') is string
          && request.resource.data.get('authorityId', '') != ''
          && request.resource.data.get('city', '') is string
          && request.resource.data.get('city', '') != '';
    }
    function authorityFieldsLocked() {
      let cur = resource.data;
      let nxt = request.resource.data;
      return (cur.get('authorityId', '') == '' || cur.get('authorityId', '') == nxt.get('authorityId', ''))
          && (cur.get('city', '') == ''        || cur.get('city', '')        == nxt.get('city', ''));
    }
    function hasResolvedCityName() {
      return request.resource.data.get('cityName', '') is string
          && request.resource.data.get('cityName', '') != '';
    }
    function cityNameFieldLocked() {
      let cur = resource.data;
      let nxt = request.resource.data;
      return cur.get('cityName', '') == '' || cur.get('cityName', '') == nxt.get('cityName', '');
    }

    match /official_routes/{docId} {
      allow read: if true;
      // AUDITED SAFE — see the guard block comment above. Not yet deployed:
      // `allow write: if isAdmin();` stays authoritative below until David's
      // explicit go per Stage 2.5's gate; the split create/update form is
      // shown commented so the exact target rule is reviewable in-place.
      // allow create: if isAdmin() && hasResolvedAuthority();
      // allow update: if isAdmin() && authorityFieldsLocked();
      // allow delete: if isAdmin();
      allow write: if isAdmin();
      // Authenticated users may update ONLY the `analytics` sub-object
      // (e.g. usageCount, lastUsed) when completing a guided route.
      // Any write that touches another top-level field is rejected.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['analytics']);
    }

    match /curated_routes/{docId} {
      allow read: if true;
      // AUDITED SAFE — see the guard block comment above. Not yet deployed.
      // allow create: if isAdmin() && hasResolvedAuthority();
      // allow update: if isAdmin() && authorityFieldsLocked();
      // allow delete: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // CLIMB SEGMENTS — topography-derived climbs (DEM) + OSM
    // structural ramps + stairs. Public read so the client route
    // generator can query climbsNear(); admin-only write (populated
    // via the DEM importer script; status pending→published/rejected
    // moderated in /admin/approval-center). Mirrors official_routes.
    // ============================================================
    match /climb_segments/{docId} {
      allow read: if true;
      // AUDITED SAFE — see the guard block comment above. Not yet deployed.
      // Note: as of 16.08.2026 NO existing climb_segments doc has
      // authorityId set (Stage 2.4's backfill script is prepared and
      // dry-run reviewed, NOT yet applied) — deploying this create guard
      // has no effect on existing docs (rules gate new writes only), but
      // any FUTURE create must resolve one; the only live writer
      // (write-climb-segments-tlv.ts) is Admin-SDK and bypasses this rule
      // regardless, so enforcement for it still routes through the
      // chokepoint once that script is migrated (Stage 3).
      // allow create: if isAdmin() && hasResolvedAuthority();
      // allow update: if isAdmin() && authorityFieldsLocked();
      // allow delete: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // STREET SEGMENTS — OSM-imported scored road/path segments
    // used by the dynamic route generator (fetchScoredWaypoints).
    // Public read so the client-side generator can query by city,
    // admin-only write (populated via the OSM importer script /
    // /admin/segments page).
    // ============================================================
    match /street_segments/{docId} {
      allow read: if true;
      // ⚠️ NOT AUDITED SAFE — see the guard block comment above.
      // official-route-broadcaster.ts writes authorityId:null for routes
      // lacking one (156 of 183 official_routes docs, live 16.08.2026).
      // DO NOT enable the create guard below until that's fixed or the
      // legacy routes are backfilled — it would silently break the
      // fire-and-forget broadcast for most existing routes.
      // allow create: if isAdmin() && hasResolvedAuthority();   // ⚠️ DO NOT ENABLE YET
      // allow update: if isAdmin() && authorityFieldsLocked();
      // allow delete: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // ROUTE ADJACENCY — precomputed geometric-adjacency edges between
    // official_routes corridors (route-adjacency.service.ts /
    // recomputeRouteAdjacencyForCity), used by the client-side
    // corridor-chaining generator (generateDiscoveredChainRoute,
    // generateUserAnchoredFlowRoute). Public read so the client
    // generator can query by cityName; admin-only write (populated by
    // InventoryService's official_routes create/delete hooks, which
    // already require isAdmin() to reach official_routes itself).
    // Mirrors official_routes/street_segments exactly. Added 16.08.2026
    // — discovered missing when the first real end-to-end run of the
    // corridor-chaining code (client SDK, not the admin-bypass Admin
    // SDK used in prior verification scripts) hit "Missing or
    // insufficient permissions" on this collection; both
    // IS_ROUTE_ADJACENCY_ENABLED features were non-functional for any
    // real user without this rule. DEPLOYED 16.08.2026, David-approved.
    //
    // cityName-only guard (this collection has no authorityId field —
    // keyed by city, see recomputeRouteAdjacencyForCity). AUDITED SAFE —
    // cityName is always set by the one writer. Not yet deployed.
    // ============================================================
    match /route_adjacency/{docId} {
      allow read: if true;
      // allow create: if isAdmin() && hasResolvedCityName();
      // allow update: if isAdmin() && cityNameFieldLocked();
      // allow delete: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // ROUTE DECISIONS — append-only accuracy-agent decision log (Stage 2,
    // .claude/plans/vectorized-twirling-tiger.md). A record of every human
    // approve/edit/drop verdict on a route, with the composition/lighting
    // signals and what the agent would have suggested at that moment —
    // NOT a route-like entity (unlike official_routes/curated_routes/
    // climb_segments/street_segments/route_adjacency above), so it does
    // NOT go through buildValidatedDoc's create/update authority-locking
    // chokepoint (src/lib/route-collections/) — see src/lib/route-
    // decisions/validate.ts's own header for the reasoning. Immutability
    // enforced here, not just by convention: update/delete are hard `false`
    // so a decision row can never be edited or removed after the fact,
    // same pattern as audit_logs above.
    // ============================================================
    match /route_decisions/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================================
    // CRM / AUTHORITIES — public read for city lookups, admin write
    // Pillar 7: pressureCount is incrementable by authenticated users
    // ============================================================
    match /authorities/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      // Users can increment pressureCount only (validated client-side with 24h dedup)
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pressureCount']);

      // pressure_logs sub-collection: any user can create, only admin reads
      match /pressure_logs/{logId} {
        allow read: if isAdmin();
        allow create: if isAuthenticated();
      }
    }

    // ============================================================
    // PRESSURE MESSAGES — dynamic message templates for league
    // ============================================================
    match /pressure_messages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // CATEGORY BRANDING — public read for facility icons
    // ============================================================
    match /category_branding/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // ADMIN — הזמנות, מדיה, עריכות, תחזוקה, ביקורת
    // ============================================================
    match /admin_invitations/{docId} {
      // Authenticated users can read invitations (needed for token validation
      // during the sign-up flow, before the user has the 'admin' role).
      // Tokens are 64-char random hex — knowledge of the token IS authorization.
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /mediaAssets/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /edit_requests/{docId} {
      allow read, write: if isAdmin();
    }

    // ============================================================
    // AUDIT LOGS — write-only via Cloud Function `logAuditAction`.
    //
    // Why direct client writes are blocked:
    //   • The Ashkelon Security Appendix (Req. 4.0) requires every
    //     audit row to record source IP. The client SDK cannot supply
    //     a trustworthy IP — anything it sends could be forged.
    //   • The `logAuditAction` Callable Cloud Function captures the
    //     real edge IP from `rawRequest.headers['x-forwarded-for']`
    //     and writes via the Admin SDK, bypassing these rules.
    //   • Read access stays admin-only per legacy.
    //
    // Net effect: NO client (regular user OR admin) can `addDoc` here
    // directly — they must call the function. Admin reads still work.
    // ============================================================
    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /maintenance_reports/{docId} {
      allow read, write: if isAdmin();
    }

    // ============================================================
    // ACTIVE WORKOUTS — live heatmap heartbeat (45s ephemeral docs)
    // Users write/delete their own doc (uid match). Admins read all
    // docs for their authority via the heatmap aggregation service.
    // ============================================================
    match /active_workouts/{userId} {
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow read: if isAdmin();
      allow read: if isOwner(userId);
    }

    // ============================================================
    // SAFE-CITY PRESENCE — live location heartbeat
    //
    // WRITE — owner only, with one constraint: if the payload includes
    //   `audienceGroupIds`, every entry must already be in the writer's
    //   `users/{uid}.social.groupIds` (server-managed, Group E above).
    //   This prevents a malicious client from broadcasting to groups it
    //   hasn't actually joined and appearing visible to their members.
    //
    // READ — gated by privacy mode:
    //   verified_global → any authenticated user (statically provable)
    //   squad           → users in the broadcaster's followers list
    //   group           → members of any of the broadcaster's audienceGroupIds
    //                     (checked against reader's server-managed groupIds)
    //   ghost           → owner only (doc is typically deleted on ghost)
    // ============================================================
    match /presence/{userId} {
      // Write: owner only + audienceGroupIds must be a subset of own groups
      // + minors (getUserAgeGroup == 'minor') may only use ghost or group mode.
      // getUserAgeGroup reads userAge/{uid} (~50 bytes) — not users/{uid}.
      allow write: if isOwner(userId)
                   && (
                     !('audienceGroupIds' in request.resource.data)
                     || request.resource.data.audienceGroupIds.size() == 0
                     || request.resource.data.audienceGroupIds.hasOnly(
                          memberGroupIds(userId))
                   )
                   && (
                     getUserAgeGroup(userId) == 'adult'
                     || request.resource.data.get('mode', 'ghost') in ['ghost', 'group']
                   );

      // Owner can always read their own doc
      allow read: if isOwner(userId);

      // Public: any authenticated user (query: where mode == 'verified_global')
      allow read: if isAuthenticated() && resource.data.mode == 'verified_global';

      // Friends: reader must be in broadcaster's followers list
      // (query: where uid in [followingList])
      allow read: if isAuthenticated()
                  && resource.data.mode == 'squad'
                  && request.auth.uid in
                     get(/databases/$(database)/documents/connections/$(userId)).data.followers;

      // Group: reader must share at least one group with the broadcaster.
      // (query: where mode=='group' AND audienceGroupIds array-contains myGroupId)
      // Security: user_memberships is Admin-SDK-only (see match below) so the
      // reader cannot spoof membership by self-writing groupIds.
      // NOTE: reads user_memberships/{uid} (tiny doc) NOT users/{uid} (may
      // exceed the 1 MiB Rules get() limit on large profiles).
      allow read: if isAuthenticated()
                  && resource.data.mode == 'group'
                  && memberGroupIds(request.auth.uid)
                       .hasAny(resource.data.get('audienceGroupIds', []));
    }

    // ============================================================
    // USER_LOCATIONS — geohash index for radius-based push targeting
    // (Phase 3, social-activities build plan). Written opportunistically by
    // the client (useUserLocationSync) whenever a map/home session has a GPS
    // fix — NOT a heartbeat, NOT presence (see presence/{userId} above for
    // that; this is a coarser, lower-frequency index purpose-built for
    // onPlannedActivityCreated's geohashQueryBounds radius query). Owner-only
    // read/write — the Cloud Function reads via Admin SDK, which bypasses
    // Rules entirely, so no cross-user read grant is needed here.
    // ============================================================
    match /userLocations/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ============================================================
    // USER_MEMBERSHIPS — lean group-membership mirror for Rules evaluation.
    //
    // Mirrors users/{uid}.social.groupIds in a tiny dedicated document so
    // that the presence group read/write rules can call get() without hitting
    // the 1 MiB Firestore Rules document-size limit that silently returns null
    // on large user profiles (running schedule + full progression data).
    //
    // Written exclusively by Admin SDK (group-membership API route + sync
    // endpoint).  Client self-write is intentionally blocked — same Group E
    // trust anchor as users.social.groupIds.
    // ============================================================
    match /user_memberships/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // USER_AGE — tiny ageGroup mirror for Firestore Rules.
    //
    // Written exclusively by Admin SDK via /api/user/complete-profile.
    // Client self-write is intentionally blocked — ageGroup is computed
    // server-side from birthDate and must never be client-spoofable.
    //
    // getUserAgeGroup() reads this doc (~50 bytes) instead of users/{uid}
    // to avoid the 1 MiB document-size limit on Firestore Rules get().
    //
    // Safe default: if this doc is missing, getUserAgeGroup() returns
    // 'minor' — unbackfilled users are always treated as minors.
    // ============================================================
    match /userAge/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // SOCIAL — connections graph + feed posts
    // ============================================================
    match /connections/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followers', 'following', 'followerCount', 'followingCount', 'updatedAt']);
    }

    // ============================================================
    // BLOCKS — one-directional block edges between users.
    //
    // Doc ID convention: `${blockerId}_${blockedId}` (see ChatThread.tsx
    // handleBlock). The deterministic id makes a block idempotent and lets
    // both the blocker and the blocked party authorize on a field they own.
    //
    //   read   → either side of the edge may read it. The blocker lists
    //            their own blocks via `where('blockerId','==',uid)`
    //            (matched by `resource.data.blockerId == uid`); the blocked
    //            party may inspect edges naming them via
    //            `where('blockedId','==',uid)`.
    //   create → only the blocker, and only for an edge they author
    //            (request payload `blockerId` must equal the requester).
    //   delete → only the blocker can lift their own block (unblock).
    //
    // No update path — a block edge is immutable; changing the target means
    // delete + create. Admins retain full access via the catch-all below.
    // ============================================================
    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (
        resource.data.blockerId == request.auth.uid ||
        resource.data.blockedId == request.auth.uid
      );
      allow create: if isAuthenticated()
                    && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated()
                    && resource.data.blockerId == request.auth.uid;
    }

    match /feed_posts/{docId} {
      // Public posts: any authenticated user
      allow read: if isAuthenticated() && resource.data.audience == 'public';
      // Partners posts: any authenticated user (client query limits by authorUid list)
      allow read: if isAuthenticated() && resource.data.audience == 'partners';
      // Private: author only
      allow read: if isAuthenticated() && request.auth.uid == resource.data.authorUid;
      // Legacy posts without audience field — allow read for backward compat
      allow read: if isAuthenticated() && !('audience' in resource.data);
      // Create: only for own posts
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.authorUid;

      // SECURITY (H1 — Feed Integrity):
      //   Update is restricted to the original author. The previous rule
      //   (`allow update: if isAuthenticated()`) let any logged-in user
      //   rewrite or deface any other user's post, including the authorUid
      //   field itself. The author check uses `resource.data.authorUid`
      //   (the EXISTING doc, not the incoming payload) so an attacker cannot
      //   spoof authorship by sending a forged `authorUid` in the request.
      //
      //   We additionally lock the `authorUid` field — even the rightful
      //   author cannot change post ownership after creation.
      allow update: if isAuthenticated()
                    && request.auth.uid == resource.data.authorUid
                    && request.resource.data.authorUid == resource.data.authorUid;

      // Delete: only the original author can remove their own post (GDPR /
      // Israeli Privacy Law compliance — users own their UGC and can erase
      // it). Authorship is checked against `resource.data.authorUid` (the
      // existing doc) so an attacker cannot spoof by sending a forged
      // payload. Compliance Phase 3.2.
      allow delete: if isAuthenticated()
                    && request.auth.uid == resource.data.authorUid;

      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // ============================================================
    // COMMUNITY & ENGAGEMENT — Pillar 1/3
    // ============================================================
    match /community_groups/{docId} {
      allow read: if isAuthenticated();
      // Admins have full write access (authority-manager dashboard)
      allow write: if isAdmin();

      // Any authenticated user can create their own community group via the in-app wizard.
      // Guards:
      //   - request.auth.uid == createdBy  →  user can only create groups for themselves
      //   - source == 'user'               →  cannot impersonate authority/professional groups
      //   - isOfficial == false            →  cannot self-grant official status
      //   - isLocked != true               →  cannot self-create an access-code-gated
      //                                        (institutional) group; only admins/authorities
      //                                        may lock a group (they bypass via isAdmin())
      // Note: social groups (friends/family) intentionally omit authorityId — this
      //       rule does not require it, so those creates are explicitly permitted.
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.createdBy
                    && request.resource.data.source == 'user'
                    && request.resource.data.isOfficial == false
                    && request.resource.data.get('isLocked', false) == false;

      // Creator can update their group (name, description, schedule, rules, images, etc.)
      // but may NOT flip the access-code lock — isLocked must stay unchanged so a
      // user cannot create an open group and then lock it. Admins bypass via isAdmin().
      allow update: if isAuthenticated()
                    && request.auth.uid == resource.data.createdBy
                    && request.resource.data.get('isLocked', false) == resource.data.get('isLocked', false);

      // Group owner OR admin may patch schedule + location fields only.
      // Scoped to exactly these keys so a group admin cannot rename the group,
      // flip isLocked, or change any other field.
      allow update: if (isGroupOwner(docId) || isGroupAdmin(docId))
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['scheduleSlots', 'meetingLocation', 'updatedAt']);

      // Any authenticated user can update only the membership counters when joining/leaving.
      // 'updatedAt' is included because group.service.ts writes it alongside the counters.
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['memberCount', 'currentParticipants', 'updatedAt']);

      // group_members sub-collection
      // create:  public groups open; private groups require inviteCode or creator privilege.
      // update:  field-level guards — role changes are restricted by caller rank.
      // delete:  self-remove always allowed; admin removes members only; owner removes anyone.
      match /members/{uid} {
        allow read: if isAuthenticated();

        allow update: if isAuthenticated() && (
          // OUT app admins bypass all group-level restrictions
          isAdmin()
          // Self-update: profile fields only — role is immutable by the member themselves
          || (request.auth.uid == uid
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
          // Any group admin can promote a member → admin (cannot act on themselves)
          || (isGroupAdmin(docId) && request.auth.uid != uid
              && resource.data.role == 'member'
              && request.resource.data.role == 'admin')
          // Only the owner can demote admin → member (cannot demote themselves)
          || (isGroupOwner(docId) && request.auth.uid != uid
              && resource.data.role == 'admin'
              && request.resource.data.role == 'member')
        );

        allow delete: if isAuthenticated() && (
          // OUT app admins bypass all group-level restrictions
          isAdmin()
          // Self-remove (leave group) — any member including owner
          || request.auth.uid == uid
          // Admin removes a regular member (role='member') — cannot remove admins or owner
          || (isGroupAdmin(docId) && request.auth.uid != uid
              && resource.data.role == 'member')
          // Owner removes anyone (including admins) except themselves
          || (isGroupOwner(docId) && request.auth.uid != uid)
        );

        allow create: if isAuthenticated() && request.auth.uid == uid
          && (
            get(/databases/$(database)/documents/community_groups/$(docId)).data.get('isPublic', false) == true
            || get(/databases/$(database)/documents/community_groups/$(docId)).data.get('inviteCode', '')
                 == request.resource.data.get('inviteCode', 'NONE_SUPPLIED')
            || get(/databases/$(database)/documents/community_groups/$(docId)).data.get('createdBy', '')
                 == request.auth.uid
          );
      }

      // attendance sub-collection — session booking / RSVP.
      // Doc ID format: {YYYY-MM-DD_HH-mm}  (NOT a uid — a date/time key).
      //
      // Write rules are split by field category:
      //   RSVP fields  → any authenticated user (booking.service.ts)
      //   Phase fields → group admin only (session-phase.service.ts)
      match /attendance/{sessionId} {
        allow read: if isAuthenticated();

        // RSVP: create initial doc (booking.service.ts first RSVP)
        allow create: if isAuthenticated()
          && !request.resource.data.keys().hasAny([
               'sessionPhase', 'sessionPhaseUpdatedAt', 'sessionPhaseUpdatedBy', 'lobbyExtendedUntil'
             ]);

        // RSVP: update attendance arrays / counters (booking.service.ts)
        allow update: if isAuthenticated()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'sessionPhase', 'sessionPhaseUpdatedAt', 'sessionPhaseUpdatedBy', 'lobbyExtendedUntil'
             ]);

        // Phase: group admin (or OUT admin) writes phase + lobby-extension fields only
        allow update: if isGroupAdmin(docId)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['sessionPhase', 'sessionPhaseUpdatedAt', 'sessionPhaseUpdatedBy', 'lobbyExtendedUntil']);

        // member_statuses sub-collection: each member writes only her own document
        match /member_statuses/{uid} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated() && request.auth.uid == uid;
        }
      }
    }

    match /community_events/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      // Authenticated users can increment currentRegistrations (join/leave)
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['currentRegistrations', 'updatedAt']);

      // Authenticated users may CREATE a virtual_materialized event when joining a
      // recurring group slot. Strict shape so this path can't be used to forge
      // admin-curated events:
      //   - createdBy must equal the requester (no impersonation)
      //   - source must be 'virtual_materialized' (UI distinguishes from admin events)
      //   - groupId must reference a real community_groups doc
      // The official-status badge (`isOfficial`) cannot be self-granted via this
      // path; it must equal the parent group's flag (admins still bypass via
      // the `isAdmin()` write rule above).
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.createdBy
                    && request.resource.data.source == 'virtual_materialized'
                    && request.resource.data.groupId is string
                    && request.resource.data.groupId.size() > 0
                    && (request.resource.data.isOfficial == false
                        || request.resource.data.isOfficial == null);

      // registrations sub-collection — users can write their own registration doc
      match /registrations/{uid} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    // ============================================================
    // PLANNED SESSIONS — ephemeral "I'm heading to this route/park"
    // declarations. Powers:
    //   • RouteDetailSheet & ParkDetailSheet "אני מגיע ב..." buttons
    //   • Partner-finder hub (usePartnerData)
    //   • useParkEvents personal-arrival stream
    // Reads are open to any authenticated user; the upstream queries
    // are bounded by parkId / routeId / userId / status / expiresAt
    // so this is not an unbounded firehose. Writes are scoped to the
    // doc owner — matched against `userId` on the resource (existing
    // doc for update/delete, request payload for create).
    // ============================================================
    match /planned_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAuthenticated()
                            && request.auth.uid == resource.data.userId;
    }

    // ============================================================
    // KUDOS — high-five inbox
    // ============================================================
    match /kudos/{recipientUid}/inbox/{kudoId} {
      allow read: if isOwner(recipientUid);
      allow create: if isAuthenticated();
      allow update: if isOwner(recipientUid);
    }

    // ============================================================
    // ACTIVITY FEED — Pillar 5
    // Users can read their own feed; users can write to their own
    // feed (join events) and to city-wide feeds (city_xxx).
    // ============================================================
    match /activity/{scopeId}/feed/{eventId} {
      allow read: if isAuthenticated()
                  && (isOwner(scopeId) || scopeId.matches('city_.*'));
      allow write: if isAdmin();
      allow create: if isAuthenticated()
                    && (request.auth.uid == scopeId
                        || scopeId.matches('city_.*'));
    }

    // ============================================================
    // DIRECT MESSAGES & GROUP CHATS — Pillar 5
    // ============================================================
    match /chats/{chatId} {
      // Existing participants can read their thread (DM + group)
      allow read: if isAuthenticated()
                  && request.auth.uid in resource.data.participants;
      // Any authenticated user can read a group-type chat
      // (needed to check existence before joining and for inbox listing)
      allow read: if isAuthenticated()
                  && resource.data.type == 'group';

      // Existence check on a non-existent chat doc.
      //
      // `getOrCreateChat` (src/features/social/services/chat.service.ts)
      // probes `chats/{chatId}` with getDoc() before deciding whether to
      // create a new DM. For a brand-new pair, the doc doesn't exist;
      // both rules above dereference `resource.data` so they evaluate to
      // false against a null resource and Firestore returns
      // PERMISSION_DENIED instead of `snap.exists() === false`. That's
      // the [useChatStore] openDM failure the user hit.
      //
      // Allowing authenticated reads on missing chat docs leaks nothing:
      //   • No fields are returned (the doc has none).
      //   • Chat IDs are deterministic from sorted participant UIDs, so
      //     any caller who has both UIDs (e.g. via the partner finder
      //     they just clicked) could already construct the same id.
      //   • Existing-chat reads still require participant membership
      //     (rule above), so message content stays private.
      // Group-chat existence is already public via the type=='group'
      // rule above, so this only changes behaviour for not-yet-created
      // DM threads, which is exactly the path getOrCreateChat needs.
      allow read: if isAuthenticated() && resource == null;

      // DM create: requesting user in participants, exactly 2 people.
      //
      // SECURITY (Compliance Phase 2.2 — Minor DM Block):
      //   Both participants must have core.ageGroup == 'adult'. Minors
      //   (under 18) cannot initiate or be added to a DM. ageGroup is
      //   set server-side in onboarding-sync.service.ts from the user's
      //   birthDate (re-validated in the sync service, see Phase 2.1).
      //
      //   Defensive .get() calls — if the user doc or core.ageGroup field
      //   is missing, the comparison fails ('' != 'adult') and creation is
      //   denied. Legacy users without ageGroup must re-onboard or be
      //   backfilled by admin tooling before they can create new DMs.
      //
      //   NOTE: This rule covers DM creation only. Group chats (`type ==
      //   'group'`) are handled by a separate allow-create rule below; the
      //   group-chat case is intentionally left open until tenant-scoped
      //   group rules are added.
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.type == 'dm'
                    && get(/databases/$(database)/documents/users/$(request.resource.data.participants[0]))
                         .data.get('core', {}).get('ageGroup', '') == 'adult'
                    && get(/databases/$(database)/documents/users/$(request.resource.data.participants[1]))
                         .data.get('core', {}).get('ageGroup', '') == 'adult';
      // Group chat create: requesting user in participants, type == 'group'
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.type == 'group';

      // Existing participants can update (send message metadata, mark read, etc.)
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participants;
      // Group chat JOIN: any authenticated user can add themselves to a group chat.
      // After arrayUnion(uid), request.resource.data.participants will contain uid.
      allow update: if isAuthenticated()
                    && resource.data.type == 'group'
                    && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        // Read: participant of the parent chat
        allow read: if isAuthenticated()
                    && request.auth.uid in
                       get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Create: sender must be themselves and be a participant
        allow create: if isAuthenticated()
                      && request.auth.uid == request.resource.data.senderUid
                      && request.auth.uid in
                         get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Update: only to add uid to readBy
        allow update: if isAuthenticated()
                      && request.auth.uid in
                         get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ============================================================
    // REPORTS — user-submitted content reports
    // create: any signed-in user (no helper functions — avoids get()
    //   evaluation side-effects from the catch-all isAdmin() rule)
    // read/manage: root admins + users whose role is admin/authority/root
    // ============================================================
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        request.auth.token.email.matches('(?i)^(david|office)@appout\\.co\\.il$') ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'authority', 'root']
      );
    }

    // ============================================================
    // REFERRALS — tracking
    // ============================================================
    match /referrals/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // ============================================================
    // GROUP INVITATIONS — session-specific time-limited join tokens (Phase G).
    // Created by the session host when opening the lobby.
    // Consumed by joining users (attendance write happens client-side via the
    // service after validation; only useCount is updated here).
    // Tokens are cryptographic random — unguessable ID is the primary security layer.
    // ============================================================
    match /group_invitations/{token} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.hostUid;
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.hostUid;
      // Only useCount may be incremented by authenticated users (token consumption).
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount']);
    }

    match /manager_notifications/{docId} {
      allow read, write: if isAdmin();
    }

    match /push_messages/{docId} {
      allow read, write: if isAdmin();
    }

    // ============================================================
    // ACCOUNT METRICS — Social KPI snapshots (followers, saves).
    //
    // Manually entered via /admin/marketing-hub.
    // source: 'manual' | 'api' — API writes will use Admin SDK and
    // bypass these rules; client writes are always admin-only.
    // History is append-only by convention (never delete a snapshot).
    // ============================================================
    match /account_metrics/{docId} {
      allow read, write: if isRootAdmin() || isAdmin();
    }

    // ============================================================
    // CONTENT ITEMS — Marketing Hub תור תוכן (content pipeline).
    //
    // All CRUD via the admin panel (/admin/marketing-hub).
    // No public read — drafts and ideas are internal assets.
    // Agent writes go through the Admin SDK (bypass rules) so
    // agentGenerated items don't need an authenticated user.
    // ============================================================
    match /content_items/{docId} {
      allow read, write: if isRootAdmin() || isAdmin();
    }

    // ============================================================
    // MARKETING LINKS — UTM Registry (Growth Hub)
    //
    // Written and managed EXCLUSIVELY by authenticated admins via
    // the Admin Panel at /admin/links. The anonymous click-tracking
    // API route (`/api/links/[id]/click`) uses the Admin SDK, which
    // bypasses these rules entirely — anonymous browser visits must
    // NEVER reach this collection directly via the client SDK.
    //
    // Security rationale:
    //   • No `allow create/update/delete: if isAuthenticated()` —
    //     regular users have zero write access. Any leaked link ID
    //     cannot be used to inflate clicksCount from the client.
    //   • No public read — campaign URLs are an internal asset; a
    //     competitor or bot should not be able to enumerate them.
    //   • The Admin SDK route is the only path that bumps clicksCount,
    //     ensuring counter integrity without exposing a write surface.
    // ============================================================
    match /marketing_links/{docId} {
      allow read, write: if isRootAdmin() || isAdmin();
    }

    // ============================================================
    // PRODUCT ROADMAP & FEEDBACK
    // ============================================================
    match /product_roadmap/{docId} {
      allow read, write: if isAdmin();
    }

    match /product_tags/{docId} {
      allow read, write: if isAdmin();
    }

    match /user_feedback/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // ============================================================
    // SESSIONS — park check-ins
    // ============================================================
    match /sessions/{docId} {
      // Admins retain full access (heatmap / analytics tooling).
      allow read, write: if isRootAdmin() || isAdmin();

      // Reads stay open to authenticated users: the admin heatmap
      // (route-overlay.service) and analytics aggregate across users via
      // authorityId queries. (Tightening reads is a separate follow-up.)
      allow read: if isAuthenticated();

      // Writes are owner-scoped. Client check-ins are addDoc() with
      // userId == current uid (useRunningPlayer). Server purges/seeds use
      // the Admin SDK and bypass these rules.
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated()
                            && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // SCHOOLS / ORGANIZATIONS — code validation for B2E access
    // ============================================================
    match /schools/{docId} {
      // Read denied to clients — school/org codes are NOT public (was
      // `allow read: if true`, enabling unauthenticated enumeration of every
      // code). Admins still read via the ADMIN FALLBACK catch-all at the
      // bottom of this file (admin schools page). The only client reader,
      // validateOrganizationCode(), is dead code; B2E code validation runs
      // through the validateAccessCode Cloud Function on `access_codes`.
      allow read: if false;
      allow write: if isAdmin();
    }

    // ============================================================
    // ACCESS CODES — validated exclusively by the validateAccessCode
    // Cloud Function (Admin SDK bypasses rules). Clients must NEVER read
    // this collection directly: doing so previously let any signed-in user
    // enumerate every code + the PII written by the CF (lastUsedByUid,
    // lastUsedByDisplayName). Reads are now admin-only; the admin panel
    // reader satisfies isAdmin(), the CF uses the Admin SDK.
    // ============================================================
    match /access_codes/{codeId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // PE GRADES — teacher grading (docId: {uid}_{term})
    // Teachers (admin) write; students read their own grades.
    // ============================================================
    match /pe_grades/{docId} {
      allow read, write: if isRootAdmin() || isAdmin();
      allow read: if isAuthenticated() &&
        docId.size() > request.auth.uid.size() &&
        docId[0:request.auth.uid.size()] == request.auth.uid &&
        docId[request.auth.uid.size():request.auth.uid.size()+1] == '_';
    }

    // ============================================================
    // READINESS CONFIGS — military fitness thresholds per unit
    // Tenant-isolated: only users in the same tenant can read.
    // ============================================================
    match /readiness_configs/{unitId} {
      allow read: if isAuthenticated() &&
        hasTenant(resource.data.tenantId);
      allow write: if isAdmin();
    }

    // ============================================================
    // LEADERBOARD SHARDS — distributed counters (written by CF)
    // Clients should not write directly; reads are tenant-scoped.
    // ============================================================
    match /leaderboard_shards/{shardId} {
      allow read: if isAuthenticated();
      allow write: if isRootAdmin() || isAdmin();
    }

    // ============================================================
    // LEADERBOARD SNAPSHOTS — rolled-up rankings (written by CF)
    // Read-only for authenticated users; tenant-scoped.
    // ============================================================
    match /leaderboard_snapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow write: if isRootAdmin() || isAdmin();
    }

    // ============================================================
    // TENANTS & UNITS — multi-tenant hierarchy
    // Tenant reads gated by Custom Claim. Admins can write.
    // ============================================================
    match /tenants/{tenantId} {
      allow read: if hasTenant(tenantId);
      allow write: if isAdmin();

      match /units/{unitId} {
        allow read: if hasTenant(tenantId);
        allow write: if isAdmin();
      }
    }

    // ============================================================
    // VISUAL ASSESSMENT SYSTEM — תוכן, חוקים, סף תוכניות
    // ============================================================
    match /visual_assessment_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assessment_rules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /program_thresholds/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // USER CONTRIBUTIONS — Community Intelligence reports & edits
    // ============================================================
    match /user_contributions/{docId} {
      // Create: only for own contributions
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Owner reads their own contributions (reports, edits, reviews)
      allow read: if isAuthenticated()
        && request.auth.uid == resource.data.userId;

      // Reviews are public park content — any authenticated user can read
      allow read: if isAuthenticated()
        && resource.data.type == 'review';

      // Admin full access
      allow read, update, delete: if isRootAdmin() || isAdmin();
    }

    // ============================================================
    // SYSTEM CONFIG — feature flags (real-time app toggles)
    // Public read: feature flags are not sensitive data and must load
    // immediately for anonymous / pre-auth users without permission errors.
    // Only Root Admins / Super Admins may write.
    // ============================================================
    match /system_config/{docId} {
      allow read: if true;
      allow write: if isRootAdmin() || isAdmin();
    }

    // ============================================================
    // PHOTO RELEASE SUBMISSIONS — public, unauthenticated consent forms
    //
    // Parents open a standalone WhatsApp link (/public/forms/photo-release)
    // and submit a signed photo/video release for their child WITHOUT
    // logging in. Therefore:
    //   • create → open to anyone (guest parents), but the payload shape is
    //     validated so the collection cannot be abused as arbitrary storage.
    //   • read / update / delete → admins only. Submissions are an immutable
    //     legal record; nobody can read or tamper with them from the client.
    //
    // App Check (reCAPTCHA Enterprise on web) still attests every write, and
    // the validation below caps the signature/string sizes to keep documents
    // small and prevent write-bombing.
    // ============================================================
    function isValidPhotoRelease() {
      return request.resource.data.formType == 'photo_release'
          && request.resource.data.consentAccepted == true
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 200
          && request.resource.data.school is string
          && request.resource.data.school.size() <= 200
          && request.resource.data.studentClass is string
          && request.resource.data.studentClass.size() <= 100
          && request.resource.data.parentName is string
          && request.resource.data.parentName.size() > 0
          && request.resource.data.parentName.size() <= 200
          && request.resource.data.parentId is string
          && request.resource.data.parentId.size() <= 20
          && request.resource.data.signatureData is string
          && request.resource.data.signatureData.size() > 0
          && request.resource.data.signatureData.size() < 700000;
    }

    match /photo_release_submissions/{docId} {
      allow create: if isValidPhotoRelease();
      allow read, update, delete: if isRootAdmin() || isAdmin();
    }

    // ============================================================
    // LEGAL HOLD — ארכיב משפטי (שמירת 7 שנים מכוח חוק ההתיישנות)
    // ============================================================
    // Post-deletion archive of workouts, park sessions and health
    // declaration references retained for the 7-year Israeli statute
    // of limitations (Limitation Law 5718-1958). Written and purged
    // EXCLUSIVELY by Cloud Functions via the Admin SDK (which bypasses
    // these rules entirely).
    //
    // Client access policy:
    //   • No regular user — including the data subject — may read or
    //     write their own legal_hold record (these explicit `if false`
    //     rules deny them).
    //   • Admins retain read access for legal proceedings via the
    //     ADMIN FALLBACK catch-all below (Firestore ORs all matching
    //     rules, so the admin grant still applies). This satisfies the
    //     "admin-only access via security rules" requirement.
    match /legal_hold/{uid} {
      allow read, write: if false;
      match /{allPaths=**} {
        allow read, write: if false;
      }
    }

    // ============================================================
    // ADMIN FALLBACK — אדמין יכול לגשת לכל מסמך
    // ============================================================
    match /{document=**} {
      allow read, write: if isRootAdmin() || isAdmin();
    }
  }
}
