<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                App Links — Android autoVerify.
                Each <data> tag repeats scheme+host to prevent Android's attribute
                merging from producing cross-product matches (e.g. any-host + /join).
                Paths mirror the iOS AASA: /join/*, /session/*, /school/*,
                /community, /gateway.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="outrun.co.il" android:pathPrefix="/join" />
                <data android:scheme="https" android:host="outrun.co.il" android:pathPrefix="/session" />
                <data android:scheme="https" android:host="outrun.co.il" android:pathPrefix="/school" />
                <data android:scheme="https" android:host="outrun.co.il" android:pathPrefix="/community" />
                <data android:scheme="https" android:host="outrun.co.il" android:pathPrefix="/gateway" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Required by Google Play for Health Connect permission usage disclosure.
             Lets users view which Health Connect permissions this app uses from
             the Android Settings → Privacy → Health Connect screen. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location: foreground only. Used for nearby parks, run-route tracking,
         and surfacing local fitness communities. No background location is
         requested or used. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Push Notifications (Sprint 3, Phase 4.3).
         POST_NOTIFICATIONS is a runtime permission required by Android 13
         (API 33) and above. Older Android versions grant it implicitly.
         The @capacitor-firebase/messaging plugin owns the runtime prompt
         (triggered from src/lib/native/push.ts → requestPermissions()). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera (profile photo upload via @capacitor/camera).
         Runtime prompt is owned by the plugin: Camera.requestPermissions().
         Gallery read permissions (READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE)
         are intentionally omitted: @capacitor/camera uses the system photo
         picker (ACTION_PICK / PhotoPicker API) which grants one-time scoped
         URI access without requiring a broad storage permission. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Health Connect — step / calorie / exercise tracking.
         Mirrored here from plugins/health-bridge/android/AndroidManifest.xml
         as required by Google Play's Data Safety review pipeline: permissions
         declared only in a sub-library manifest are not surfaced correctly in
         the Play Console. The plugin manifest also declares them so the AAR
         keeps working stand-alone; Gradle's manifest merger dedupes the two.
         Per-record permissions are shown to the user via the Health Connect
         grant screen launched by HealthBridgePlugin → requestPermissions()
         → PermissionController.createRequestPermissionResultContract(). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- Health Connect write permissions for workout recording. Mirrored
         from the plugin manifest so Play's Data Safety section picks them up. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" />

    <!-- Step-counter / activity sensor fallback for devices running Android < 10
         or without Health Connect. On Android 10+ this is a runtime permission;
         the plugin's requestPermissions() flow handles the runtime prompt. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Package visibility (Android 11 +): required to detect whether the
         Health Connect provider app is installed. Without this the
         HealthConnectClient.getSdkStatus() call returns SDK_UNAVAILABLE. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
