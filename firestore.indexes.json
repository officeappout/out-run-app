    // ── Growth Hub: Push CTR Analytics ────────────────────────────────────
    // Required by the Admin Dashboard CTR panel and the Funnel Analytics
    // service (`funnel-analytics.service.ts`) which query notification_clicks
    // across ALL users via:
    //   collectionGroup('notification_clicks')
    //     .where('messageId', '==', id)
    //     .where('clickedAt', '>=', since)
    // Without this index the query falls back to a full sub-collection scan
    // and Firebase Console shows a "Missing index" error link.
    {
      "collectionGroup": "notification_clicks",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "messageId", "order": "ASCENDING" },
        { "fieldPath": "clickedAt", "order": "DESCENDING" }
      ]
    },
    // Secondary index: filter by channel for per-channel CTR breakdowns.
    {
      "collectionGroup": "notification_clicks",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "messageId",   "order": "ASCENDING" },
        { "fieldPath": "channel",     "order": "ASCENDING" },
        { "fieldPath": "clickedAt",   "order": "DESCENDING" }
      ]
    },

    // ── Growth Hub: Marketing Links (UTM Registry) ────────────────────────
    // Used by `getMarketingLinks()` in marketing-links.service.ts:
    //   collection('marketing_links').orderBy('createdAt', 'desc')
    // Also supports filtering by isActive in the Admin Panel table.
    {
      "collectionGroup": "marketing_links",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive",  "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },

    // ── Growth Hub: Funnel Dashboard, filter by one link/QR code ──────────
    // Used by `funnel-analytics.service.ts` stages 1/4/5 when an admin
    // picks a single marketing_links doc (e.g. one physical QR) with the
    // default "all time" date range collapsed to a >= bound. Pre-provisioned
    // because filtering one QR code's funnel is the primary use case this
    // whole feature exists for — every OTHER filter combination (source ×
    // gender, campaign × medium, etc.) is left to Firestore's own
    // auto-suggest-on-first-failure flow, same as before this index existed.
    {
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "marketingAttribution.linkId", "order": "ASCENDING" },
        { "fieldPath": "createdAt",                   "order": "ASCENDING" }
      ]
    },

    // ── Growth Hub: Onboarding Drop-off Dispatcher ────────────────────────
    // Required by the scheduled Cloud Function `onboardingDropoffDispatcher`
    // which queries:
    //   collection('users')
    //     .where('onboardingStatus', '==', 'IN_PROGRESS')
    //     .where('createdAt', '<=', staleBefore)      ← range on createdAt
    // Firestore requires a composite index when combining equality + range
    // filters on different fields.
    {
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "onboardingStatus", "order": "ASCENDING" },
        { "fieldPath": "createdAt",        "order": "ASCENDING" }
      ]
    },

    // ── Challenge submissions — gender-filtered leaderboard ────────────────
    // Required by /api/challenge/leaderboard?gender=male|female
    // Uses COLLECTION_GROUP to cover all community_groups/{groupId}/challenge_submissions
    {
      "collectionGroup": "challenge_submissions",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "gender",     "order": "ASCENDING" },
        { "fieldPath": "bestValue",  "order": "DESCENDING" }
      ]
    },

    // ── Leagues: getScopeCompetitionLeaderboard / getGroupCompetitionLeaderboard ──
    // (17.08.2026) These two ranking.service.ts functions query feed_posts
    // via collection(db, 'feed_posts') — a top-level COLLECTION query, not
    // collection-group — filtering some combination of authorityId/schoolId,
    // activityCategory, gender, plus a mandatory createdAt >= range. Unlike
    // every other feed_posts leaderboard query in this file, these two never
    // filter by ageGroup, so none of the ageGroup-prefixed indexes above
    // cover them — each distinct combination below needs its own index.
    // The crash this fixes: neighborhood-granularity + a gender filter hits
    // authorityId+gender+createdAt with no matching index at all.
