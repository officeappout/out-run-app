# Runtime config for Cloud Functions in this codebase (functions/) — loaded automatically by
# the Firebase Functions v2 runtime at deploy time and in emulation. NOT the same mechanism as
# the repo-root .env.local.
#
# Copy this file to functions/.env (gitignored, never committed) and fill in real values before
# building/deploying. functions/.env is deployed from disk, not from the repo — David deploys
# manually, so the real file lives only on his machine.
#
# NEXT_PUBLIC_MAPBOX_TOKEN — required by the vendored geo-discovery-routes.ts (functions/src/
# _vendor/scripts/geo-discovery-routes.ts) for Mapbox Terrain-RGB DEM elevation tiles
# (loadTiles()).
NEXT_PUBLIC_MAPBOX_TOKEN=
